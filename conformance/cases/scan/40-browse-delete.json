{
 "tier": "v1",
 "description": "The folder picker (GET /api/browse, admin) and item deletion (DELETE /api/items/{id}, admin): the file goes, the row stays missing (D-068, D-073).",
 "cases": [
  {
   "name": "browse lists visible subdirectories",
   "requires": [
    "scan_media"
   ],
   "steps": [
    {
     "req": {
      "method": "GET",
      "path": "/api/browse?path={{scan_media}}",
      "auth": "admin"
     },
     "expect": {
      "status": 200,
      "body": {
       "path": "{{scan_media}}",
       "parent": "$string",
       "detected": false,
       "dirs": [
        {
         "name": "Frieren",
         "path": "$string"
        },
        {
         "name": "Movies",
         "path": "$string"
        },
        {
         "name": "Show",
         "path": "$string"
        }
       ]
      }
     }
    },
    {
     "req": {
      "method": "GET",
      "path": "/api/browse?path=relative/path",
      "auth": "admin"
     },
     "expect": {
      "status": 400,
      "body": {
       "error": "path must be absolute"
      }
     }
    },
    {
     "req": {
      "method": "GET",
      "path": "/api/browse?path={{scan_media}}/no-such-dir",
      "auth": "admin"
     },
     "expect": {
      "status": 400,
      "body": {
       "error": "path is not a readable directory"
      }
     }
    },
    {
     "req": {
      "method": "GET",
      "path": "/api/browse",
      "auth": "admin"
     },
     "expect": {
      "status": 200,
      "body": {
       "path": "$string",
       "parent": "$string",
       "detected": true,
       "dirs": "$array"
      }
     }
    },
    {
     "req": {
      "method": "GET",
      "path": "/api/browse?path={{scan_media}}",
      "auth": "bob"
     },
     "expect": {
      "status": 403,
      "body": {
       "error": "admin required"
      }
     }
    }
   ]
  },
  {
   "name": "deleting an item needs an admin",
   "requires": [
    "scan_media"
   ],
   "steps": [
    {
     "req": {
      "method": "DELETE",
      "path": "/api/items/{{show}}",
      "auth": "bob"
     },
     "expect": {
      "status": 403,
      "body": {
       "error": "admin required"
      }
     }
    },
    {
     "req": {
      "method": "DELETE",
      "path": "/api/items/no-such-item",
      "auth": "bob"
     },
     "expect": {
      "status": 403,
      "body": {
       "error": "admin required"
      }
     }
    },
    {
     "req": {
      "method": "DELETE",
      "path": "/api/items/{{show}}"
     },
     "expect": {
      "status": 401,
      "body": {
       "error": "unauthorized"
      }
     }
    },
    {
     "req": {
      "method": "DELETE",
      "path": "/api/items/no-such-item",
      "auth": "admin"
     },
     "expect": {
      "status": 404,
      "body": {
       "error": "unknown item"
      }
     }
    }
   ]
  },
  {
   "name": "the file goes, the row stays missing",
   "requires": [
    "scan_media"
   ],
   "steps": [
    {
     "req": {
      "method": "PUT",
      "path": "/api/items/{{show}}/progress",
      "auth": "bob",
      "body": {
       "position_sec": 30,
       "duration_sec": 1440
      }
     },
     "expect": {
      "status": 200
     }
    },
    {
     "req": {
      "method": "DELETE",
      "path": "/api/items/{{show}}",
      "auth": "admin"
     },
     "expect": {
      "status": 200,
      "body": {
       "id": "{{show}}",
       "library_id": "{{lib}}",
       "file_path": "$string",
       "size": 1,
       "updated_at": "$int",
       "$open": true,
       "title": "Show Name",
       "missing": true
      }
     }
    },
    {
     "req": {
      "method": "GET",
      "path": "/api/catalog/{{show}}",
      "auth": "bob"
     },
     "expect": {
      "status": 200,
      "body": {
       "id": "{{show}}",
       "library_id": "{{lib}}",
       "file_path": "$string",
       "size": 1,
       "updated_at": "$int",
       "$open": true,
       "missing": true
      }
     }
    },
    {
     "req": {
      "method": "GET",
      "path": "/api/items/{{show}}/progress",
      "auth": "bob"
     },
     "expect": {
      "status": 200,
      "body": {
       "item_id": "{{show}}",
       "position_sec": 30,
       "$open": true
      }
     }
    },
    {
     "req": {
      "method": "DELETE",
      "path": "/api/items/{{show}}",
      "auth": "admin"
     },
     "expect": {
      "status": 200,
      "body": {
       "id": "{{show}}",
       "library_id": "{{lib}}",
       "file_path": "$string",
       "size": 1,
       "updated_at": "$int",
       "$open": true,
       "missing": true
      }
     }
    },
    {
     "req": {
      "method": "GET",
      "path": "/api/browse?path={{scan_media}}/Show",
      "auth": "admin"
     },
     "expect": {
      "status": 200,
      "body": {
       "path": "$string",
       "parent": "$string",
       "detected": false,
       "dirs": []
      }
     }
    }
   ]
  }
 ]
}
