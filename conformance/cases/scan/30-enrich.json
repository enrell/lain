{
 "tier": "v1",
 "description": "Metadata overlays (lain.metadata.enrich@1) from the offline NFO provider: the search binding is swapped to it first so no case touches the network.",
 "cases": [
  {
   "name": "metadata search uses the NFO provider only",
   "requires": [
    "scan_media"
   ],
   "steps": [
    {
     "req": {
      "method": "POST",
      "path": "/api/plugins/swap",
      "auth": "admin",
      "body": {
       "capability": "lain.metadata.search@1",
       "providers": [
        "lain-metadata-nfo"
       ],
       "generation": 0
      }
     },
     "expect": {
      "status": 200,
      "body": {
       "generation": "$int",
       "composition": "$array"
      }
     }
    }
   ]
  },
  {
   "name": "admins enrich an item from its tvshow.nfo",
   "requires": [
    "scan_media"
   ],
   "steps": [
    {
     "req": {
      "method": "POST",
      "path": "/api/catalog/{{f1}}/enrich",
      "auth": "bob"
     },
     "expect": {
      "status": 403,
      "body": {
       "error": "admin required"
      }
     }
    },
    {
     "req": {
      "method": "POST",
      "path": "/api/catalog/{{f1}}/enrich",
      "auth": "admin"
     },
     "expect": {
      "status": 200,
      "body": {
       "item_id": "{{f1}}",
       "provider": "lain-metadata-nfo",
       "remote_id": "$string",
       "title": "Sousou no Frieren",
       "year": 2023,
       "genres": [
        "Fantasy",
        "Adventure"
       ],
       "synopsis": "An elf mage looks back.",
       "poster": "https://example.invalid/poster.jpg",
       "cover": "https://example.invalid/fanart.jpg",
       "fetched_at": "$int"
      }
     }
    },
    {
     "req": {
      "method": "GET",
      "path": "/api/catalog/{{f1}}/enrich",
      "auth": "bob"
     },
     "expect": {
      "status": 200,
      "body": {
       "item_id": "{{f1}}",
       "provider": "lain-metadata-nfo",
       "remote_id": "$string",
       "title": "Sousou no Frieren",
       "year": 2023,
       "genres": [
        "Fantasy",
        "Adventure"
       ],
       "synopsis": "An elf mage looks back.",
       "poster": "https://example.invalid/poster.jpg",
       "cover": "https://example.invalid/fanart.jpg",
       "fetched_at": "$int"
      }
     }
    },
    {
     "req": {
      "method": "POST",
      "path": "/api/catalog/no-such-item/enrich",
      "auth": "admin"
     },
     "expect": {
      "status": 404,
      "body": {
       "error": "unknown item"
      }
     }
    }
   ]
  },
  {
   "name": "an item without metadata",
   "requires": [
    "scan_media"
   ],
   "steps": [
    {
     "req": {
      "method": "POST",
      "path": "/api/catalog/{{akira}}/enrich",
      "auth": "admin"
     },
     "expect": {
      "status": 404,
      "body": {
       "error": "not-found: no metadata found"
      }
     }
    },
    {
     "req": {
      "method": "GET",
      "path": "/api/catalog/{{akira}}/enrich",
      "auth": "bob"
     },
     "expect": {
      "status": 404,
      "body": {
       "error": "not-found: not enriched"
      }
     }
    }
   ]
  },
  {
   "name": "overlays in one batch read",
   "requires": [
    "scan_media"
   ],
   "steps": [
    {
     "req": {
      "method": "GET",
      "path": "/api/enrichments?ids={{f1}},%20{{akira}},,no-such-item",
      "auth": "bob"
     },
     "expect": {
      "status": 200,
      "body": {
       "items": [
        {
         "item_id": "{{f1}}",
         "provider": "lain-metadata-nfo",
         "remote_id": "$string",
         "title": "Sousou no Frieren",
         "year": 2023,
         "genres": [
          "Fantasy",
          "Adventure"
         ],
         "synopsis": "An elf mage looks back.",
         "poster": "https://example.invalid/poster.jpg",
         "cover": "https://example.invalid/fanart.jpg",
         "fetched_at": "$int"
        }
       ]
      }
     }
    },
    {
     "req": {
      "method": "GET",
      "path": "/api/enrichments?ids=no-such-item",
      "auth": "bob"
     },
     "expect": {
      "status": 200,
      "body": {
       "items": []
      }
     }
    },
    {
     "req": {
      "method": "GET",
      "path": "/api/enrichments",
      "auth": "bob"
     },
     "expect": {
      "status": 400,
      "body": {
       "error": "ids required"
      }
     }
    },
    {
     "req": {
      "method": "GET",
      "path": "/api/enrichments?ids=%20",
      "auth": "bob"
     },
     "expect": {
      "status": 400,
      "body": {
       "error": "ids required"
      }
     }
    },
    {
     "req": {
      "method": "GET",
      "path": "/api/enrichments?ids={{f1}}"
     },
     "expect": {
      "status": 401,
      "body": {
       "error": "unauthorized"
      }
     }
    }
   ]
  },
  {
   "name": "admins remove an overlay",
   "requires": [
    "scan_media"
   ],
   "steps": [
    {
     "req": {
      "method": "DELETE",
      "path": "/api/catalog/{{f1}}/enrich",
      "auth": "bob"
     },
     "expect": {
      "status": 403,
      "body": {
       "error": "admin required"
      }
     }
    },
    {
     "req": {
      "method": "DELETE",
      "path": "/api/catalog/{{f1}}/enrich",
      "auth": "admin"
     },
     "expect": {
      "status": 200,
      "body": {
       "status": "ok"
      }
     }
    },
    {
     "req": {
      "method": "GET",
      "path": "/api/catalog/{{f1}}/enrich",
      "auth": "bob"
     },
     "expect": {
      "status": 404,
      "body": {
       "error": "not-found: not enriched"
      }
     }
    },
    {
     "req": {
      "method": "DELETE",
      "path": "/api/catalog/{{f1}}/enrich",
      "auth": "admin"
     },
     "expect": {
      "status": 200,
      "body": {
       "status": "ok"
      }
     }
    }
   ]
  }
 ]
}
