{
  "tier": "v1",
  "description": "The social module from a fresh server: privacy settings and favorites, friend requests, blocks, user search and profiles, ratings, reviews, comments and moderation, the feed, notifications, work shares and collections. Works are named by kind and title (a fresh server has no catalog).",
  "cases": [
    {"name": "accounts", "steps": [
      {"req": {"method": "POST", "path": "/api/setup", "body": {"username": "admin", "password": "password123"}}, "expect": {"status": 201}},
      {"req": {"method": "POST", "path": "/api/auth/login", "body": {"username": "admin", "password": "password123"}}, "expect": {"status": 200}, "save": {"admin": "/token"}},
      {"req": {"method": "POST", "path": "/api/users", "auth": "admin", "body": {"username": "bob", "password": "bobpassword"}}, "expect": {"status": 201}},
      {"req": {"method": "POST", "path": "/api/users", "auth": "admin", "body": {"username": "carol", "password": "carolpassword"}}, "expect": {"status": 201}},
      {"req": {"method": "POST", "path": "/api/users", "auth": "admin", "body": {"username": "dave", "password": "davepassword"}}, "expect": {"status": 201}},
      {"req": {"method": "POST", "path": "/api/auth/login", "body": {"username": "bob", "password": "bobpassword"}}, "expect": {"status": 200}, "save": {"bob": "/token"}},
      {"req": {"method": "POST", "path": "/api/auth/login", "body": {"username": "carol", "password": "carolpassword"}}, "expect": {"status": 200}, "save": {"carol": "/token"}},
      {"req": {"method": "POST", "path": "/api/auth/login", "body": {"username": "dave", "password": "davepassword"}}, "expect": {"status": 200}, "save": {"dave": "/token"}}
    ]},
    {"name": "social routes need a session", "steps": [
      {"req": {"method": "GET", "path": "/api/social/feed"}, "expect": {"status": 401, "body": {"error": "unauthorized"}}},
      {"req": {"method": "GET", "path": "/api/social/me/settings"}, "expect": {"status": 401}},
      {"req": {"method": "POST", "path": "/api/social/friends/user-bob"}, "expect": {"status": 401}}
    ]},
    {"name": "settings default and validate", "steps": [
      {"req": {"method": "GET", "path": "/api/social/me/settings", "auth": "bob"},
       "expect": {"status": 200, "body": {"user_id": "user-bob", "profile": "public", "activity": "friends", "ratings": "friends",
         "discoverable": true, "allow_requests": "everyone", "hide_progress": false, "favorites": []}}},
      {"req": {"method": "PATCH", "path": "/api/social/me/settings", "auth": "bob", "body": {"profile": "everyone"}},
       "expect": {"status": 400, "body": {"error": "visibility must be public, friends or private", "code": "invalid-message"}}},
      {"req": {"method": "PATCH", "path": "/api/social/me/settings", "auth": "bob", "body": {"allow_requests": "some"}},
       "expect": {"status": 400, "body": {"error": "allow_requests must be everyone or nobody", "code": "invalid-message"}}},
      {"req": {"method": "PATCH", "path": "/api/social/me/settings", "auth": "bob", "body": {"favorites": [{"item_id": "no-such-item"}]}},
       "expect": {"status": 404, "body": {"error": "unknown item", "code": "not-found"}}},
      {"req": {"method": "PATCH", "path": "/api/social/me/settings", "auth": "bob", "raw_body": "["}, "expect": {"status": 400, "body": {"error": "invalid json"}}},
      {"req": {"method": "PATCH", "path": "/api/social/me/settings", "auth": "bob",
               "body": {"favorites": [{"kind": " MANGA ", "title": "  Frieren "}, {"kind": "manga", "title": "frieren"}, {"kind": "comic", "title": "Saga", "item_id": "gone"}]}},
       "expect": {"status": 200, "body": {"user_id": "user-bob", "favorites": [{"kind": "manga", "title": "Frieren"}, {"kind": "comic", "title": "Saga"}],
         "updated_at": "$int", "$open": true}}},
      {"req": {"method": "PATCH", "path": "/api/social/me/settings", "auth": "dave", "body": {"discoverable": false}},
       "expect": {"status": 200, "body": {"discoverable": false, "$open": true}}}
    ]},
    {"name": "friend requests", "steps": [
      {"req": {"method": "POST", "path": "/api/social/friends/user-carol", "auth": "bob"},
       "expect": {"status": 200, "body": {"user": {"id": "user-carol", "username": "carol", "avatar": {}}, "relation": "outgoing"}}},
      {"req": {"method": "POST", "path": "/api/social/friends/user-carol", "auth": "bob"}, "expect": {"status": 200, "body": {"relation": "outgoing", "$open": true}}},
      {"req": {"method": "GET", "path": "/api/social/notifications", "auth": "carol"},
       "expect": {"status": 200, "body": {"items": [{"id": "$string", "user_id": "user-carol", "type": "friend_request", "from_user_id": "user-bob", "read": false, "at": "$int"}],
         "unread": 1, "users": {"user-bob": {"id": "user-bob", "username": "bob", "avatar": {}}}}}},
      {"req": {"method": "GET", "path": "/api/social/friends", "auth": "carol"},
       "expect": {"status": 200, "body": {"friends": [], "incoming": [{"user": {"id": "user-bob", "username": "bob", "avatar": {}}, "since": "$int"}], "outgoing": [], "blocked": []}}},
      {"req": {"method": "POST", "path": "/api/social/friends/user-carol/decline", "auth": "bob"},
       "expect": {"status": 404, "body": {"error": "no pending request from this account", "code": "not-found"}}},
      {"req": {"method": "POST", "path": "/api/social/friends/user-bob", "auth": "carol"}, "expect": {"status": 200, "body": {"relation": "friend", "$open": true}}},
      {"req": {"method": "GET", "path": "/api/social/notifications", "auth": "carol"}, "expect": {"status": 200, "body": {"items": [{"read": true, "$open": true}], "unread": 0, "$open": true}}},
      {"req": {"method": "GET", "path": "/api/social/notifications", "auth": "bob"},
       "expect": {"status": 200, "body": {"items": [{"type": "friend_accepted", "from_user_id": "user-carol", "$open": true}], "unread": 1, "$open": true}}},
      {"req": {"method": "GET", "path": "/api/social/friends", "auth": "bob"},
       "expect": {"status": 200, "body": {"friends": [{"user": {"id": "user-carol", "$open": true}, "since": "$int"}], "incoming": [], "outgoing": [], "blocked": []}}},
      {"req": {"method": "POST", "path": "/api/social/friends/user-bob", "auth": "bob"}, "expect": {"status": 400, "body": {"error": "cannot relate to yourself", "code": "invalid-message"}}},
      {"req": {"method": "POST", "path": "/api/social/friends/user-nobody", "auth": "bob"}, "expect": {"status": 404, "body": {"error": "unknown user", "code": "not-found"}}},
      {"req": {"method": "POST", "path": "/api/social/friends/user-dave", "auth": "admin"}, "expect": {"status": 200, "body": {"relation": "outgoing", "$open": true}}},
      {"req": {"method": "DELETE", "path": "/api/social/friends/user-dave", "auth": "admin"}, "expect": {"status": 200, "body": {"relation": "none", "$open": true}}},
      {"req": {"method": "PATCH", "path": "/api/social/me/settings", "auth": "dave", "body": {"allow_requests": "nobody"}}, "expect": {"status": 200}},
      {"req": {"method": "POST", "path": "/api/social/friends/user-dave", "auth": "admin"},
       "expect": {"status": 403, "body": {"error": "this account does not accept friend requests", "code": "forbidden"}}}
    ]},
    {"name": "search and profiles", "steps": [
      {"req": {"method": "GET", "path": "/api/social/users?q=CAR", "auth": "bob"},
       "expect": {"status": 200, "body": {"users": [{"user": {"id": "user-carol", "username": "carol", "avatar": {}}, "relation": "friend"}]}}},
      {"req": {"method": "GET", "path": "/api/social/users?q=dave", "auth": "bob"}, "expect": {"status": 200, "body": {"users": []}}},
      {"req": {"method": "GET", "path": "/api/social/users", "auth": "bob"},
       "expect": {"status": 200, "body": {"users": [{"user": {"id": "user-admin", "$open": true}, "relation": "none"}, {"user": {"id": "user-carol", "$open": true}, "relation": "friend"}]}}},
      {"req": {"method": "GET", "path": "/api/social/users/user-bob", "auth": "carol"},
       "expect": {"status": 200, "body": {"user": {"id": "user-bob", "username": "bob", "avatar": {}}, "relation": "friend", "self": false,
         "visible": {"profile": true, "activity": true, "ratings": true}, "bio": "",
         "favorites": [{"kind": "manga", "title": "Frieren"}, {"kind": "comic", "title": "Saga"}]}}},
      {"req": {"method": "GET", "path": "/api/social/users/user-bob", "auth": "admin"},
       "expect": {"status": 200, "body": {"relation": "none", "self": false, "visible": {"profile": true, "activity": false, "ratings": false}, "$open": true}}},
      {"req": {"method": "PATCH", "path": "/api/social/me/settings", "auth": "bob", "body": {"profile": "private"}}, "expect": {"status": 200}},
      {"req": {"method": "GET", "path": "/api/social/users/user-bob", "auth": "admin"},
       "expect": {"status": 200, "body": {"favorites": [], "bio": "$absent", "visible": {"profile": false, "activity": false, "ratings": false}, "$open": true}}},
      {"req": {"method": "GET", "path": "/api/social/users/user-bob", "auth": "bob"},
       "expect": {"status": 200, "body": {"self": true, "relation": "none", "visible": {"profile": true, "activity": true, "ratings": true}, "$open": true}}},
      {"req": {"method": "PATCH", "path": "/api/social/me/settings", "auth": "bob", "body": {"profile": "public"}}, "expect": {"status": 200}},
      {"req": {"method": "GET", "path": "/api/social/users/user-nobody", "auth": "bob"}, "expect": {"status": 404, "body": {"error": "unknown user", "code": "not-found"}}}
    ]},
    {"name": "ratings and reviews", "steps": [
      {"req": {"method": "PUT", "path": "/api/social/work/rating", "auth": "carol", "body": {"work": {"kind": "manga", "title": "FRIEREN"}, "score": 9, "review": "  quiet\nand kind "}},
       "expect": {"status": 200, "body": {"user_id": "user-carol", "work": {"kind": "manga", "title": "FRIEREN"}, "score": 9, "review": "quiet\nand kind", "created_at": "$int", "updated_at": "$int"}}},
      {"req": {"method": "PUT", "path": "/api/social/work/rating", "auth": "admin", "body": {"work": {"kind": "manga", "title": "Frieren"}, "score": 3}}, "expect": {"status": 200}},
      {"req": {"method": "PUT", "path": "/api/social/work/rating", "auth": "bob", "body": {"work": {"kind": "manga", "title": "Frieren"}, "score": 11}},
       "expect": {"status": 400, "body": {"error": "score must be 1..10, or 0 for a review without a score", "code": "invalid-message"}}},
      {"req": {"method": "PUT", "path": "/api/social/work/rating", "auth": "bob", "body": {"work": {"kind": "manga", "title": "Frieren"}}},
       "expect": {"status": 400, "body": {"error": "a rating needs a score or a review", "code": "invalid-message"}}},
      {"req": {"method": "PUT", "path": "/api/social/work/rating", "auth": "bob", "body": {"work": {"kind": "ma nga", "title": "Frieren"}, "score": 5}},
       "expect": {"status": 400, "body": {"error": "work kind must be a lowercase token", "code": "invalid-message"}}},
      {"req": {"method": "GET", "path": "/api/social/work?kind=manga&title=frieren", "auth": "bob"},
       "expect": {"status": 200, "body": {"work": {"kind": "manga", "title": "frieren"}, "mine": null,
         "ratings": [{"user_id": "user-carol", "score": 9, "$open": true}], "average": 9, "scored": 1, "comments": [],
         "users": {"user-bob": {"$open": true}, "user-carol": {"$open": true}}}}},
      {"req": {"method": "GET", "path": "/api/social/work?kind=manga&title=Frieren", "auth": "admin"},
       "expect": {"status": 200, "body": {"mine": {"score": 3, "$open": true}, "ratings": [], "average": 3, "scored": 1, "$open": true}}},
      {"req": {"method": "GET", "path": "/api/social/work?item=no-such-item", "auth": "bob"}, "expect": {"status": 404, "body": {"error": "unknown item", "code": "not-found"}}},
      {"req": {"method": "GET", "path": "/api/social/users/user-carol/ratings", "auth": "bob"},
       "expect": {"status": 200, "body": {"ratings": [{"user_id": "user-carol", "score": 9, "$open": true}]}}},
      {"req": {"method": "GET", "path": "/api/social/users/user-carol/ratings", "auth": "admin"}, "expect": {"status": 200, "body": {"ratings": []}}},
      {"req": {"method": "DELETE", "path": "/api/social/work/rating?kind=manga&title=Frieren", "auth": "admin"}, "expect": {"status": 200, "body": {"removed": true}}},
      {"req": {"method": "DELETE", "path": "/api/social/work/rating?kind=manga&title=Frieren", "auth": "admin"}, "expect": {"status": 200, "body": {"removed": false}}}
    ]},
    {"name": "the feed shows friends' visible activity", "steps": [
      {"req": {"method": "GET", "path": "/api/social/feed", "auth": "bob"},
       "expect": {"status": 200, "body": {"items": [{"id": "$string", "user_id": "user-carol", "type": "rated", "work": {"kind": "manga", "title": "FRIEREN"}, "score": 9, "at": "$int"}],
         "users": {"user-carol": {"id": "user-carol", "username": "carol", "avatar": {}}}}}},
      {"req": {"method": "GET", "path": "/api/social/feed", "auth": "admin"}, "expect": {"status": 200, "body": {"items": [], "users": {}}}},
      {"req": {"method": "GET", "path": "/api/social/users/user-carol/activity", "auth": "bob"},
       "expect": {"status": 200, "body": {"items": [{"type": "rated", "$open": true}], "users": {"user-carol": {"$open": true}}}}},
      {"req": {"method": "GET", "path": "/api/social/users/user-carol/activity", "auth": "admin"},
       "expect": {"status": 200, "body": {"items": [], "users": {"user-carol": {"$open": true}}}}}
    ]},
    {"name": "comments, replies and moderation", "steps": [
      {"req": {"method": "POST", "path": "/api/social/work/comments", "auth": "bob", "body": {"work": {"kind": "manga", "title": "Frieren"}, "body": "chapter 60 tho"}},
       "expect": {"status": 201, "body": {"id": "$string", "user_id": "user-bob", "work": {"kind": "manga", "title": "Frieren"}, "body": "chapter 60 tho", "created_at": "$int"}},
       "save": {"c1": "/id"}},
      {"req": {"method": "POST", "path": "/api/social/work/comments", "auth": "carol", "body": {"work": {"kind": "manga", "title": "Frieren"}, "body": "yes", "reply_to": "{{c1}}"}},
       "expect": {"status": 201, "body": {"reply_to": "{{c1}}", "$open": true}}, "save": {"c2": "/id"}},
      {"req": {"method": "POST", "path": "/api/social/work/comments", "auth": "carol", "body": {"work": {"kind": "anime", "title": "Frieren"}, "body": "x", "reply_to": "{{c1}}"}},
       "expect": {"status": 404, "body": {"error": "unknown comment", "code": "not-found"}}},
      {"req": {"method": "POST", "path": "/api/social/work/comments", "auth": "carol", "body": {"work": {"kind": "manga", "title": "Frieren"}, "body": "  "}},
       "expect": {"status": 400, "body": {"error": "comment is empty", "code": "invalid-message"}}},
      {"req": {"method": "GET", "path": "/api/social/notifications", "auth": "bob"},
       "expect": {"status": 200, "body": {"items": [{"type": "reply", "from_user_id": "user-carol", "work": {"kind": "manga", "title": "Frieren"}, "comment_id": "{{c2}}", "$open": true}, {"type": "friend_accepted", "$open": true}], "unread": 2, "$open": true}}},
      {"req": {"method": "GET", "path": "/api/social/work?kind=manga&title=Frieren", "auth": "dave"},
       "expect": {"status": 200, "body": {"comments": [{"id": "{{c1}}", "$open": true}, {"id": "{{c2}}", "$open": true}], "$open": true}}},
      {"req": {"method": "DELETE", "path": "/api/social/comments/{{c1}}", "auth": "carol"},
       "expect": {"status": 403, "body": {"error": "only the author or an admin can delete a comment", "code": "forbidden"}}},
      {"req": {"method": "DELETE", "path": "/api/social/comments/{{c1}}", "auth": "admin"}, "expect": {"status": 200, "body": {"removed": true}}},
      {"req": {"method": "DELETE", "path": "/api/social/comments/{{c1}}", "auth": "bob"}, "expect": {"status": 404, "body": {"error": "unknown comment", "code": "not-found"}}}
    ]},
    {"name": "work shares go to friends", "steps": [
      {"req": {"method": "POST", "path": "/api/social/share", "auth": "bob", "body": {"to": ["user-carol", "user-carol", "user-bob"], "work": {"kind": "comic", "title": "Saga"}, "message": "read this"}},
       "expect": {"status": 200, "body": {"sent": ["user-carol"]}}},
      {"req": {"method": "POST", "path": "/api/social/share", "auth": "bob", "body": {"to": ["user-admin"], "work": {"kind": "comic", "title": "Saga"}}},
       "expect": {"status": 403, "body": {"error": "you can only share with friends", "code": "forbidden"}}},
      {"req": {"method": "POST", "path": "/api/social/share", "auth": "bob", "body": {"to": [], "work": {"kind": "comic", "title": "Saga"}}},
       "expect": {"status": 400, "body": {"error": "choose at least one friend", "code": "invalid-message"}}},
      {"req": {"method": "GET", "path": "/api/social/notifications?limit=1", "auth": "carol"},
       "expect": {"status": 200, "body": {"items": [{"type": "share", "work": {"kind": "comic", "title": "Saga"}, "message": "read this", "read": false, "$open": true}], "unread": 1, "$open": true}},
       "save": {"n1": "/items/0/id"}},
      {"req": {"method": "POST", "path": "/api/social/notifications/read", "auth": "carol", "body": {"ids": ["{{n1}}"]}}, "expect": {"status": 200, "body": {"changed": 1}}},
      {"req": {"method": "POST", "path": "/api/social/notifications/read", "auth": "bob", "body": {"all": true}}, "expect": {"status": 200, "body": {"changed": 2}}},
      {"req": {"method": "GET", "path": "/api/social/notifications", "auth": "bob"}, "expect": {"status": 200, "body": {"unread": 0, "$open": true}}}
    ]},
    {"name": "collections and their sharing", "steps": [
      {"req": {"method": "POST", "path": "/api/social/collections", "auth": "bob", "body": {"name": "  Cozy   reads ", "description": "for rain"}},
       "expect": {"status": 201, "body": {"collection": {"id": "$string", "owner_id": "user-bob", "name": "Cozy reads", "description": "for rain", "visibility": "private",
         "shared_with": [], "items": [], "created_at": "$int", "updated_at": "$int"}, "users": {"user-bob": {"$open": true}}}}, "save": {"col": "/collection/id"}},
      {"req": {"method": "POST", "path": "/api/social/collections", "auth": "bob", "body": {"name": " "}}, "expect": {"status": 400, "body": {"error": "name required", "code": "invalid-message"}}},
      {"req": {"method": "POST", "path": "/api/social/collections/{{col}}/items", "auth": "bob", "body": {"work": {"kind": "manga", "title": "Frieren"}}},
       "expect": {"status": 200, "body": {"collection": {"items": [{"work": {"kind": "manga", "title": "Frieren"}, "added_at": "$int"}], "$open": true}, "$open": true}}},
      {"req": {"method": "POST", "path": "/api/social/collections/{{col}}/items", "auth": "bob", "body": {"work": {"kind": "movie", "title": "Perfect Blue"}, "note": "start here"}},
       "expect": {"status": 200, "body": {"collection": {"items": {"$len": 2}, "$open": true}, "$open": true}}},
      {"req": {"method": "GET", "path": "/api/social/collections/{{col}}", "auth": "carol"}, "expect": {"status": 404, "body": {"error": "unknown collection", "code": "not-found"}}},
      {"req": {"method": "POST", "path": "/api/social/collections/{{col}}/items", "auth": "carol", "body": {"work": {"kind": "manga", "title": "x"}}},
       "expect": {"status": 404, "body": {"error": "unknown collection", "code": "not-found"}}},
      {"req": {"method": "POST", "path": "/api/social/collections/{{col}}/share", "auth": "bob", "body": {"to": ["user-carol"], "message": "rainy day"}},
       "expect": {"status": 200, "body": {"sent": ["user-carol"]}}},
      {"req": {"method": "GET", "path": "/api/social/collections/{{col}}", "auth": "carol"},
       "expect": {"status": 200, "body": {"collection": {"id": "{{col}}", "shared_with": [], "$open": true}, "users": {"user-bob": {"$open": true}}}}},
      {"req": {"method": "GET", "path": "/api/social/collections/{{col}}", "auth": "bob"},
       "expect": {"status": 200, "body": {"collection": {"shared_with": ["user-carol"], "$open": true}, "users": {"user-bob": {"$open": true}, "user-carol": {"$open": true}}}}},
      {"req": {"method": "PATCH", "path": "/api/social/collections/{{col}}", "auth": "carol", "body": {"name": "mine now"}},
       "expect": {"status": 403, "body": {"error": "only the owner can change a collection", "code": "forbidden"}}},
      {"req": {"method": "GET", "path": "/api/social/collections", "auth": "carol"},
       "expect": {"status": 200, "body": {"collections": [{"id": "{{col}}", "$open": true}], "users": {"user-bob": {"$open": true}}}}},
      {"req": {"method": "GET", "path": "/api/social/users/user-bob/collections", "auth": "admin"}, "expect": {"status": 200, "body": {"collections": [], "$open": true}}},
      {"req": {"method": "PATCH", "path": "/api/social/collections/{{col}}", "auth": "bob", "body": {"visibility": "public"}},
       "expect": {"status": 200, "body": {"collection": {"visibility": "public", "$open": true}, "$open": true}}},
      {"req": {"method": "PATCH", "path": "/api/social/collections/{{col}}", "auth": "bob", "body": {"visibility": "open"}},
       "expect": {"status": 400, "body": {"error": "visibility must be public, friends or private", "code": "invalid-message"}}},
      {"req": {"method": "GET", "path": "/api/social/users/user-bob/collections", "auth": "admin"},
       "expect": {"status": 200, "body": {"collections": [{"id": "{{col}}", "shared_with": [], "$open": true}], "users": {"user-bob": {"$open": true}}}}},
      {"req": {"method": "DELETE", "path": "/api/social/collections/{{col}}/items?kind=manga&title=FRIEREN", "auth": "bob"},
       "expect": {"status": 200, "body": {"collection": {"items": [{"work": {"kind": "movie", "title": "Perfect Blue"}, "note": "start here", "added_at": "$int"}], "$open": true}, "$open": true}}},
      {"req": {"method": "DELETE", "path": "/api/social/collections/{{col}}/share/user-carol", "auth": "bob"},
       "expect": {"status": 200, "body": {"collection": {"shared_with": [], "$open": true}, "users": {"user-bob": {"$open": true}}}}},
      {"req": {"method": "DELETE", "path": "/api/social/collections/{{col}}", "auth": "carol"}, "expect": {"status": 404, "body": {"error": "unknown collection", "code": "not-found"}}},
      {"req": {"method": "DELETE", "path": "/api/social/collections/{{col}}", "auth": "bob"}, "expect": {"status": 200, "body": {"removed": true}}},
      {"req": {"method": "GET", "path": "/api/social/collections/{{col}}", "auth": "bob"}, "expect": {"status": 404, "body": {"error": "unknown collection", "code": "not-found"}}}
    ]},
    {"name": "a block hides the account both ways", "steps": [
      {"req": {"method": "POST", "path": "/api/social/blocks/user-bob", "auth": "carol"}, "expect": {"status": 200, "body": {"user": {"id": "user-bob", "$open": true}, "relation": "blocking"}}},
      {"req": {"method": "GET", "path": "/api/social/users/user-carol", "auth": "bob"}, "expect": {"status": 404, "body": {"error": "unknown user", "code": "not-found"}}},
      {"req": {"method": "GET", "path": "/api/social/users?q=carol", "auth": "bob"}, "expect": {"status": 200, "body": {"users": []}}},
      {"req": {"method": "POST", "path": "/api/social/friends/user-carol", "auth": "bob"}, "expect": {"status": 404, "body": {"error": "unknown user", "code": "not-found"}}},
      {"req": {"method": "POST", "path": "/api/social/friends/user-bob", "auth": "carol"}, "expect": {"status": 403, "body": {"error": "unblock this account first", "code": "forbidden"}}},
      {"req": {"method": "GET", "path": "/api/social/friends", "auth": "bob"}, "expect": {"status": 200, "body": {"friends": [], "incoming": [], "outgoing": [], "blocked": []}}},
      {"req": {"method": "GET", "path": "/api/social/friends", "auth": "carol"},
       "expect": {"status": 200, "body": {"friends": [], "incoming": [], "outgoing": [], "blocked": [{"user": {"id": "user-bob", "$open": true}, "since": "$int"}]}}},
      {"req": {"method": "GET", "path": "/api/social/feed", "auth": "bob"}, "expect": {"status": 200, "body": {"items": [], "users": {}}}},
      {"req": {"method": "DELETE", "path": "/api/social/blocks/user-bob", "auth": "carol"}, "expect": {"status": 200, "body": {"relation": "none", "$open": true}}},
      {"req": {"method": "GET", "path": "/api/social/users/user-carol", "auth": "bob"}, "expect": {"status": 200, "body": {"relation": "none", "$open": true}}}
    ]},
    {"name": "disabled accounts disappear", "steps": [
      {"req": {"method": "POST", "path": "/api/social/friends/user-bob", "auth": "dave"}, "expect": {"status": 200, "body": {"relation": "outgoing", "$open": true}}},
      {"req": {"method": "PATCH", "path": "/api/users/user-dave", "auth": "admin", "body": {"disabled": true}}, "expect": {"status": 200}},
      {"req": {"method": "GET", "path": "/api/social/friends", "auth": "bob"}, "expect": {"status": 200, "body": {"friends": [], "incoming": [], "outgoing": [], "blocked": []}}},
      {"req": {"method": "GET", "path": "/api/social/users/user-dave", "auth": "bob"}, "expect": {"status": 404, "body": {"error": "unknown user", "code": "not-found"}}},
      {"req": {"method": "POST", "path": "/api/social/friends/user-dave", "auth": "bob"}, "expect": {"status": 404, "body": {"error": "unknown user", "code": "not-found"}}},
      {"req": {"method": "GET", "path": "/api/social/notifications", "auth": "bob"},
       "expect": {"status": 200, "body": {"items": {"$contains": [{"type": "friend_request", "from_user_id": "user-dave", "$open": true}]}, "users": {"user-dave": "$absent", "$open": true}, "$open": true}}}
    ]}
  ]
}
