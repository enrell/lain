  {
   "name": "presets: a Prowlarr's indexers in one step, tried before saving",
   "requires": [
    "acq_media",
    "upstream"
   ],
   "steps": [
    {
     "req": {
      "method": "POST",
      "path": "/api/integrations",
      "auth": "admin",
      "body": {
       "name": "coding agent",
       "scopes": [
        "indexers"
       ],
       "ttl_seconds": 900
      }
     },
     "expect": {
      "status": 201,
      "body": {
       "id": "$string",
       "name": "coding agent",
       "libraries": [],
       "created_at": "$int",
       "scopes": [
        "indexers"
       ],
       "expires_at": "$int",
       "key": "$string"
      }
     },
     "save": {
      "agent2": "/key",
      "agent2_id": "/id"
     }
    },
    {
     "req": {
      "method": "POST",
      "path": "/api/acquire/indexers/discover",
      "auth": "agent2",
      "body": {
       "source": "prowlarr",
       "url": "{{upstream}}/prowlarr/",
       "api_key": "wrong"
      }
     },
     "expect": {
      "status": 502,
      "body": {
       "error": "$substr:the API key was rejected",
       "code": "auth-failed"
      }
     }
    },
    {
     "req": {
      "method": "POST",
      "path": "/api/acquire/indexers/discover",
      "auth": "agent2",
      "body": {
       "source": "prowlarr",
       "url": "{{upstream}}/prowlarr/",
       "api_key": "prowlarr-key"
      }
     },
     "expect": {
      "status": 200,
      "body": {
       "source": "prowlarr",
       "indexers": [
        {
         "source_id": "1",
         "name": "tracker-exemplo",
         "protocol": "torznab",
         "url": "{{upstream}}/prowlarr/1/api",
         "privacy": "public",
         "enabled": true
        },
        {
         "source_id": "2",
         "name": "usenet-exemplo",
         "protocol": "newznab",
         "url": "{{upstream}}/prowlarr/2/api",
         "privacy": "private",
         "enabled": false
        }
       ]
      }
     }
    },
    {
     "req": {
      "method": "POST",
      "path": "/api/acquire/indexers/import",
      "auth": "agent2",
      "body": {
       "source": "prowlarr",
       "url": "{{upstream}}/prowlarr",
       "api_key": "prowlarr-key",
       "ids": [
        "7"
       ]
      }
     },
     "expect": {
      "status": 404,
      "body": {
       "error": "prowlarr does not serve an indexer 7",
       "code": "not-found"
      }
     }
    },
    {
     "req": {
      "method": "POST",
      "path": "/api/acquire/indexers/import",
      "auth": "agent2",
      "body": {
       "source": "prowlarr",
       "url": "{{upstream}}/prowlarr",
       "api_key": "prowlarr-key",
       "ids": [
        "1"
       ]
      }
     },
     "expect": {
      "status": 201,
      "body": {
       "added": [
        {
         "$open": true,
         "id": "$string",
         "name": "tracker-exemplo",
         "protocol": "torznab",
         "url": "{{upstream}}/prowlarr/1/api",
         "enabled": true,
         "has_api_key": true,
         "api_key": "$absent"
        }
       ],
       "skipped": []
      }
     },
     "save": {
      "pix": "/added/0/id"
     }
    },
    {
     "req": {
      "method": "POST",
      "path": "/api/acquire/indexers/import",
      "auth": "agent2",
      "body": {
       "source": "prowlarr",
       "url": "{{upstream}}/prowlarr",
       "api_key": "prowlarr-key",
       "ids": [
        "1"
       ]
      }
     },
     "expect": {
      "status": 200,
      "body": {
       "added": [],
       "skipped": [
        "1"
       ]
      }
     }
    },
    {
     "req": {
      "method": "POST",
      "path": "/api/acquire/indexers/discover",
      "auth": "agent2",
      "body": {
       "source": "prowlarr",
       "url": "{{upstream}}/prowlarr",
       "api_key": "prowlarr-key"
      }
     },
     "expect": {
      "status": 200,
      "body": {
       "source": "prowlarr",
       "indexers": [
        {
         "$open": true,
         "source_id": "1",
         "added_as": "{{pix}}"
        },
        {
         "$open": true,
         "source_id": "2",
         "added_as": "$absent"
        }
       ]
      }
     }
    },
    {
     "req": {
      "method": "POST",
