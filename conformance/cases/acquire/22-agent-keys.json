{
 "tier": "v2",
 "description": "Integration keys with the indexers scope (D-290): a coding agent sets up indexers through the same routes as the web, with a key that opens nothing else, never travels in a URL, expires and is revoked at once; the Prowlarr/Jackett presets (discover, import) and the probe that tries an indexer before it is saved (D-290); the agent guide (D-291).",
 "cases": [
  {
   "name": "an indexers key is made with its own shape",
   "requires": [
    "acq_media"
   ],
   "steps": [
    {
     "req": {
      "method": "POST",
      "path": "/api/integrations",
      "auth": "admin",
      "body": {
       "name": "coding agent",
       "scopes": [
        "indexers"
       ]
      }
     },
     "expect": {
      "status": 201,
      "body": {
       "id": "$string",
       "name": "coding agent",
       "libraries": [],
       "created_at": "$int",
       "scopes": [
        "indexers"
       ],
       "expires_at": "$int",
       "key": "$prefix:lain_"
      }
     },
     "save": {
      "agent_key": "/key",
      "agent_id": "/id"
     }
    },
    {
     "req": {
      "method": "POST",
      "path": "/api/integrations",
      "auth": "admin",
      "body": {
       "name": "x",
       "scopes": [
        "indexers"
       ],
       "libraries": [
        "{{lib}}"
       ]
      }
     },
     "expect": {
      "status": 400,
      "body": {
       "error": "an indexers key takes no libraries"
      }
     }
    },
    {
     "req": {
      "method": "POST",
      "path": "/api/integrations",
      "auth": "admin",
      "body": {
       "name": "x",
       "scopes": [
        "indexers"
       ],
       "ttl_seconds": 10
      }
     },
     "expect": {
      "status": 400,
      "body": {
       "error": "ttl_seconds: 60 to 86400 for an indexers key"
      }
     }
    },
    {
     "req": {
      "method": "POST",
      "path": "/api/integrations",
      "auth": "admin",
      "body": {
       "name": "x",
       "scopes": [
        "indexers"
       ],
       "ttl_seconds": 86401
      }
     },
     "expect": {
      "status": 400,
      "body": {
       "error": "ttl_seconds: 60 to 86400 for an indexers key"
      }
     }
    },
    {
     "req": {
      "method": "POST",
      "path": "/api/integrations",
      "auth": "admin",
      "body": {
       "name": "x",
       "scopes": [
        "admin"
       ]
      }
     },
     "expect": {
      "status": 400,
      "body": {
       "error": "scopes: one of library or indexers"
      }
     }
    },
    {
     "req": {
      "method": "POST",
      "path": "/api/integrations",
      "auth": "admin",
      "body": {
       "name": "x",
       "scopes": [
        "library",
        "indexers"
       ],
       "libraries": [
        "{{lib}}"
       ]
      }
     },
     "expect": {
      "status": 400,
      "body": {
       "error": "scopes: one of library or indexers"
      }
     }
    },
    {
     "req": {
      "method": "POST",
      "path": "/api/integrations",
      "auth": "admin",
      "body": {
       "name": "x"
      }
     },
     "expect": {
      "status": 400,
      "body": {
       "error": "at least one library required"
      }
     }
    },
    {
     "req": {
      "method": "POST",
      "path": "/api/integrations",
      "auth": "bob",
      "body": {
       "name": "x",
       "scopes": [
        "indexers"
       ]
      }
     },
     "expect": {
      "status": 403,
      "body": {
       "error": "admin required"
      }
     }
    },
    {
     "req": {
      "method": "POST",
      "path": "/api/integrations",
      "auth": "admin",
      "body": {
       "name": "importer",
       "libraries": [
        "{{lib}}"
       ]
      }
     },
     "expect": {
      "status": 201,
      "body": {
       "id": "$string",
       "name": "importer",
       "libraries": [
        "{{lib}}"
       ],
       "created_at": "$int",
       "scopes": [
        "library"
       ],
       "expires_at": 0,
       "key": "$prefix:lain_"
      }
     },
     "save": {
      "library_key": "/key",
      "library_key_id": "/id"
     }
    },
    {
     "req": {
      "method": "GET",
      "path": "/api/integrations",
      "auth": "admin"
     },
     "expect": {
      "status": 200,
      "body": {
       "integrations": {
        "$len": 2,
        "$contains": [
         {
          "id": "{{agent_id}}",
          "name": "coding agent",
          "libraries": [],
          "created_at": "$int",
          "scopes": [
           "indexers"
          ],
          "expires_at": "$int"
         }
        ]
       }
      }
     }
    }
   ]
  },
  {
   "name": "an indexers key opens the indexer routes and nothing else",
   "requires": [
    "acq_media"
   ],
   "steps": [
    {
     "req": {
      "method": "GET",
      "path": "/api/acquire/indexers",
      "auth": "agent_key"
     },
     "expect": {
      "status": 200,
      "body": {
       "indexers": "$array"
      }
     }
    },
    {
     "req": {
      "method": "POST",
      "path": "/api/acquire/indexers",
      "auth": "agent_key",
      "body": {
       "name": "agent-exemplo",
       "protocol": "torznab",
       "url": "http://127.0.0.1:9/api",
       "api_key": "feed-key",
       "min_interval_ms": 0
      }
     },
     "expect": {
      "status": 201,
      "body": {
       "$open": true,
       "id": "$string",
       "name": "agent-exemplo",
       "has_api_key": true,
       "api_key": "$absent"
      }
     },
     "save": {
      "agent_ix": "/id"
     }
    },
    {
     "req": {
      "method": "POST",
      "path": "/api/acquire/indexers/{{agent_ix}}/test",
      "auth": "agent_key"
     },
     "expect": {
      "status": 200,
      "body": {
       "$open": true,
       "ok": false,
       "error": "$substr:127.0.0.1:9"
      }
     }
    },
    {
     "req": {
      "method": "PATCH",
      "path": "/api/acquire/indexers/{{agent_ix}}",
      "auth": "agent_key",
      "body": {
       "priority": 3
      }
     },
     "expect": {
      "status": 200,
      "body": {
       "$open": true,
       "priority": 3,
       "has_api_key": true
      }
     }
    },
    {
     "req": {
      "method": "POST",
      "path": "/api/acquire/indexers/probe",
      "auth": "agent_key",
      "body": {
       "id": "{{agent_ix}}"
      }
     },
     "expect": {
      "status": 200,
      "body": {
       "ok": false,
       "sample": [],
       "error": "$substr:127.0.0.1:9"
      }
     }
    },
    {
     "req": {
      "method": "POST",
      "path": "/api/acquire/indexers/probe",
      "auth": "agent_key",
      "body": {
       "protocol": "gopher",
       "url": "http://127.0.0.1:9/api"
      }
     },
     "expect": {
      "status": 400,
      "body": {
       "error": "protocol must be torznab or newznab",
       "code": "invalid-request"
      }
     }
    },
    {
     "req": {
      "method": "POST",
      "path": "/api/acquire/indexers/discover",
      "auth": "agent_key",
      "body": {
       "source": "sonarr",
       "url": "http://127.0.0.1:9",
       "api_key": "k"
      }
     },
     "expect": {
      "status": 400,
      "body": {
       "error": "source must be prowlarr or jackett",
       "code": "invalid-request"
      }
     }
    },
    {
     "req": {
      "method": "POST",
      "path": "/api/acquire/indexers/discover",
      "auth": "agent_key",
      "body": {
       "source": "jackett",
       "url": "http://127.0.0.1:9",
       "api_key": "secret-aggregator-key"
      }
     },
     "expect": {
      "status": 502,
      "body": {
       "error": "127.0.0.1:9 did not answer",
       "code": "fetch-failed"
      }
     }
    },
    {
     "req": {
      "method": "DELETE",
      "path": "/api/acquire/indexers/{{agent_ix}}",
      "auth": "agent_key"
     },
     "expect": {
      "status": 200,
      "body": {
       "removed": true
      }
     }
    },
    {
     "req": {
      "method": "GET",
      "path": "/api/acquire/indexers",
      "auth": "query:agent_key"
     },
     "expect": {
      "status": 401,
      "body": {
       "error": "an integration key goes in the Authorization header, never in the URL"
      }
     }
    },
    {
     "req": {
      "method": "GET",
      "path": "/api/acquire/settings",
