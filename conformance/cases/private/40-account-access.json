{
  "tier": "v2",
  "description": "Slice 1 (D-295): per-account library allow-lists (libraries) and audience ceilings (everyone / teen / mature) enforced live across libraries, catalog, search, continue, item routes, thumbnails, progress and events.",
  "cases": [
    {
      "name": "per-account library allow-list: validation, empty list and live enforcement",
      "requires": ["lib_id", "item1", "item2", "data_dir"],
      "steps": [
        {"req": {"method": "PATCH", "path": "/api/libraries/{{lib_id}}", "auth": "c1", "body": {"private": false, "password": "carolpassword"}},
         "expect": {"status": 200, "body": {"id": "{{lib_id}}", "private": "$absent", "$open": true}}},
        {"req": {"method": "POST", "path": "/api/libraries", "auth": "a0", "body": {"name": "Kids", "path": "{{data_dir}}"}},
         "expect": {"status": 201}, "save": {"kids_lib": "/id"}},
        {"req": {"method": "PUT", "path": "/api/items/{{item1}}/progress", "auth": "b0", "body": {"position_sec": 30, "duration_sec": 1440}},
         "expect": {"status": 200}},
        {"req": {"method": "GET", "path": "/api/me/continue", "auth": "b0"},
         "expect": {"status": 200, "body": {"$len": 3}}},
        {"req": {"method": "PATCH", "path": "/api/users/user-bob", "auth": "a0", "body": {"libraries": ["lib-ghost"]}},
         "expect": {"status": 400, "body": {"error": "unknown library lib-ghost"}}},
        {"req": {"method": "PATCH", "path": "/api/users/user-bob", "auth": "a0", "body": {"libraries": []}},
         "expect": {"status": 200, "body": {"id": "user-bob", "libraries": [], "$open": true}}},
        {"req": {"method": "GET", "path": "/api/libraries", "auth": "b0"},
         "expect": {"status": 200, "body": []}},
        {"req": {"method": "GET", "path": "/api/catalog", "auth": "b0"},
         "expect": {"status": 200, "body": {"total": 0, "items": [], "$open": true}}},
        {"req": {"method": "GET", "path": "/api/search?q=Frieren", "auth": "b0"},
         "expect": {"status": 200, "body": {"total": 0, "items": [], "$open": true}}},
        {"req": {"method": "GET", "path": "/api/me/continue", "auth": "b0"},
         "expect": {"status": 200, "body": [{"item_id": "some-public-item", "$open": true}]}},
        {"req": {"method": "GET", "path": "/api/catalog/{{item1}}", "auth": "b0"},
         "expect": {"status": 404, "body": {"error": "unknown item"}}},
        {"req": {"method": "GET", "path": "/api/items/{{item1}}/thumbnail", "auth": "b0"},
         "expect": {"status": 404, "body": {"error": "unknown item"}}},
        {"req": {"method": "GET", "path": "/api/items/{{item1}}/progress", "auth": "b0"},
         "expect": {"status": 200, "body": {"position_sec": 0, "completed": false, "$open": true}}}
      ]
    },
    {
      "name": "live allow-list switch, deleted library cleanup and clearing back to all",
      "requires": ["lib_id", "kids_lib", "item1"],
      "steps": [
        {"req": {"method": "PATCH", "path": "/api/users/user-bob", "auth": "a0", "body": {"libraries": ["{{kids_lib}}"]}},
         "expect": {"status": 200, "body": {"id": "user-bob", "libraries": ["{{kids_lib}}"], "$open": true}}},
        {"req": {"method": "GET", "path": "/api/libraries", "auth": "b0"},
         "expect": {"status": 200, "body": [{"id": "{{kids_lib}}", "name": "Kids", "$open": true}]}},
        {"req": {"method": "GET", "path": "/api/catalog", "auth": "b0"},
         "expect": {"status": 200, "body": {"total": 0, "items": [], "$open": true}}},
        {"req": {"method": "DELETE", "path": "/api/libraries/{{kids_lib}}", "auth": "a0"},
         "expect": {"status": 200}},
        {"req": {"method": "GET", "path": "/api/me", "auth": "b0"},
         "expect": {"status": 200, "body": {"id": "user-bob", "libraries": [], "$open": true}}},
        {"req": {"method": "GET", "path": "/api/libraries", "auth": "b0"},
         "expect": {"status": 200, "body": []}},
        {"req": {"method": "PATCH", "path": "/api/users/user-bob", "auth": "a0", "body": {"libraries": null}},
         "expect": {"status": 200, "body": {"id": "user-bob", "libraries": "$absent", "$open": true}}},
        {"req": {"method": "GET", "path": "/api/catalog", "auth": "b0"},
         "expect": {"status": 200, "body": {"total": 2, "$open": true}}},
        {"req": {"method": "GET", "path": "/api/me/continue", "auth": "b0"},
         "expect": {"status": 200, "body": {"$len": 3}}}
      ]
    },
    {
      "name": "audience levels (everyone / teen / mature) and admin exemption",
      "requires": ["lib_id", "item1"],
      "steps": [
        {"req": {"method": "POST", "path": "/api/users", "auth": "a0", "body": {"username": "kid", "password": "kidpassword"}},
         "expect": {"status": 201}, "save": {"kid_id": "/id"}},
        {"req": {"method": "POST", "path": "/api/auth/login", "body": {"username": "kid", "password": "kidpassword"}},
         "expect": {"status": 200}, "save": {"k0": "/token"}},
        {"req": {"method": "PUT", "path": "/api/items/{{item1}}/progress", "auth": "k0", "body": {"position_sec": 20, "duration_sec": 1440}},
         "expect": {"status": 200}},
        {"req": {"method": "GET", "path": "/api/me/continue", "auth": "k0"},
         "expect": {"status": 200, "body": [{"item_id": "{{item1}}", "$open": true}]}},
        {"req": {"method": "PATCH", "path": "/api/libraries/{{lib_id}}", "auth": "a0", "body": {"audience": "invalid"}},
         "expect": {"status": 400}},
        {"req": {"method": "PATCH", "path": "/api/users/{{kid_id}}", "auth": "a0", "body": {"max_audience": "invalid"}},
         "expect": {"status": 400}},
        {"req": {"method": "PATCH", "path": "/api/users/{{kid_id}}", "auth": "a0", "body": {"max_audience": "everyone"}},
         "expect": {"status": 200, "body": {"id": "{{kid_id}}", "max_audience": "everyone", "$open": true}}},
        {"req": {"method": "PATCH", "path": "/api/libraries/{{lib_id}}", "auth": "a0", "body": {"audience": "teen"}},
         "expect": {"status": 200, "body": {"id": "{{lib_id}}", "audience": "teen", "$open": true}}},
        {"req": {"method": "GET", "path": "/api/libraries", "auth": "k0"},
         "expect": {"status": 200, "body": []}},
        {"req": {"method": "GET", "path": "/api/catalog", "auth": "k0"},
         "expect": {"status": 200, "body": {"total": 0, "items": [], "$open": true}}},
        {"req": {"method": "GET", "path": "/api/search?q=Frieren", "auth": "k0"},
         "expect": {"status": 200, "body": {"total": 0, "items": [], "$open": true}}},
        {"req": {"method": "GET", "path": "/api/me/continue", "auth": "k0"},
         "expect": {"status": 200, "body": []}},
        {"req": {"method": "GET", "path": "/api/catalog/{{item1}}", "auth": "k0"},
         "expect": {"status": 404, "body": {"error": "unknown item"}}},
        {"req": {"method": "GET", "path": "/api/items/{{item1}}/thumbnail", "auth": "k0"},
         "expect": {"status": 404, "body": {"error": "unknown item"}}},
        {"req": {"method": "GET", "path": "/api/libraries", "auth": "b0"},
         "expect": {"status": 200, "body": [{"id": "{{lib_id}}", "audience": "teen", "$open": true}]}},
        {"req": {"method": "GET", "path": "/api/catalog", "auth": "b0"},
         "expect": {"status": 200, "body": {"total": 2, "$open": true}}},
        {"req": {"method": "PATCH", "path": "/api/users/{{kid_id}}", "auth": "a0", "body": {"max_audience": "teen"}},
         "expect": {"status": 200, "body": {"id": "{{kid_id}}", "max_audience": "teen", "$open": true}}},
        {"req": {"method": "GET", "path": "/api/catalog", "auth": "k0"},
         "expect": {"status": 200, "body": {"total": 2, "$open": true}}},
        {"req": {"method": "PATCH", "path": "/api/libraries/{{lib_id}}", "auth": "a0", "body": {"audience": "mature"}},
         "expect": {"status": 200, "body": {"id": "{{lib_id}}", "audience": "mature", "$open": true}}},
        {"req": {"method": "GET", "path": "/api/libraries", "auth": "k0"},
         "expect": {"status": 200, "body": []}},
        {"req": {"method": "GET", "path": "/api/catalog", "auth": "k0"},
         "expect": {"status": 200, "body": {"total": 0, "items": [], "$open": true}}},
        {"req": {"method": "PATCH", "path": "/api/users/user-admin", "auth": "a0", "body": {"libraries": [], "max_audience": "everyone"}},
         "expect": {"status": 200}},
        {"req": {"method": "GET", "path": "/api/libraries", "auth": "a0"},
         "expect": {"status": 200, "body": [{"id": "{{lib_id}}", "audience": "mature", "$open": true}]}},
        {"req": {"method": "GET", "path": "/api/catalog", "auth": "a0"},
         "expect": {"status": 200, "body": {"total": 2, "$open": true}}},
        {"req": {"method": "PATCH", "path": "/api/users/user-admin", "auth": "a0", "body": {"libraries": null, "max_audience": "mature"}},
         "expect": {"status": 200, "body": {"id": "user-admin", "libraries": "$absent", "max_audience": "$absent", "$open": true}}}
      ]
    },
    {
      "name": "a new library is mature until an admin opens it (D-299)",
      "requires": ["kid_id", "k0", "data_dir"],
      "steps": [
        {"req": {"method": "POST", "path": "/api/libraries", "auth": "a0", "body": {"name": "Fresh", "path": "{{data_dir}}"}},
         "expect": {"status": 201, "body": {"name": "Fresh", "audience": "mature", "$open": true}}, "save": {"fresh_lib": "/id"}},
        {"req": {"method": "GET", "path": "/api/libraries", "auth": "k0"},
         "expect": {"status": 200, "body": []}},
        {"req": {"method": "POST", "path": "/api/libraries", "auth": "a0", "body": {"name": "Fresh", "path": "{{data_dir}}", "audience": "adult"}},
         "expect": {"status": 400, "body": {"error": "audience must be everyone, teen or mature"}}},
        {"req": {"method": "POST", "path": "/api/libraries", "auth": "a0", "body": {"name": "Fresh", "path": "{{data_dir}}", "audience": "everyone"}},
         "expect": {"status": 201, "body": {"id": "{{fresh_lib}}", "audience": "$absent", "$open": true}}},
        {"req": {"method": "GET", "path": "/api/libraries", "auth": "k0"},
         "expect": {"status": 200, "body": [{"id": "{{fresh_lib}}", "name": "Fresh", "$open": true}]}},
        {"req": {"method": "DELETE", "path": "/api/libraries/{{fresh_lib}}", "auth": "a0"},
         "expect": {"status": 200}}
      ]
    },
    {
      "name": "live events follow account and audience restrictions",
      "requires": ["lib_id", "item1", "kid_id", "k0"],
      "steps": [
        {"sse_open": {"path": "/api/events", "auth": "query:k0", "as": "kid_ev"}, "expect": {"status": 200}},
        {"sse_expect": {"stream": "kid_ev", "event": "ready"}},
        {"req": {"method": "PUT", "path": "/api/items/{{item1}}/progress", "auth": "k0", "body": {"position_sec": 12}},
         "expect": {"status": 200}},
        {"req": {"method": "PUT", "path": "/api/items/some-public-item/progress", "auth": "k0", "body": {"position_sec": 2}},
         "expect": {"status": 200}},
        {"sse_expect": {"stream": "kid_ev", "event": "progress-changed", "strict": true, "data": {"item_id": "some-public-item", "$open": true}}},
        {"req": {"method": "PATCH", "path": "/api/libraries/{{lib_id}}", "auth": "a0", "body": {"audience": "everyone"}},
         "expect": {"status": 200, "body": {"id": "{{lib_id}}", "audience": "$absent", "$open": true}}},
        {"sse_expect": {"stream": "kid_ev", "event": "library-changed", "strict": true, "data": {"library_id": "{{lib_id}}", "action": "updated"}}},
        {"req": {"method": "PATCH", "path": "/api/libraries/{{lib_id}}", "auth": "a0", "body": {"audience": "mature"}},
         "expect": {"status": 200}},
        {"sse_expect": {"stream": "kid_ev", "event": "library-changed", "strict": true, "data": {"library_id": "{{lib_id}}", "action": "updated"}}},
        {"req": {"method": "PATCH", "path": "/api/libraries/{{lib_id}}", "auth": "a0", "body": {"audience": "everyone"}},
         "expect": {"status": 200}},
        {"req": {"method": "DELETE", "path": "/api/users/{{kid_id}}", "auth": "a0"},
         "expect": {"status": 200}}
      ]
    }
  ]
}
