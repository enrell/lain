{
  "tier": "v2",
  "description": "D-296: the manager role renames and orders the libraries it can see and starts scans. Everything else stays the admin's: creating or removing a library, its folder, privacy, members and audience, the folder picker, roots, acquisition, downloads, indexers, subtitles, users, plugins, backup, integrations, transcoding, item deletion and metadata. D-295 still restricts a manager, and a private library it is not a member of does not exist for it.",
  "cases": [
    {
      "name": "an admin can create a manager, and only a known role",
      "requires": [
        "lib_id",
        "media_root"
      ],
      "steps": [
        {
          "req": {
            "method": "POST",
            "path": "/api/users",
            "auth": "a0",
            "body": {
              "username": "mina",
              "password": "minapassword",
              "role": "manager"
            }
          },
          "expect": {
            "status": 201,
            "body": {
              "id": "user-mina",
              "username": "mina",
              "role": "manager",
              "$open": true
            }
          },
          "save": {
            "mina_id": "/id"
          }
        },
        {
          "req": {
            "method": "POST",
            "path": "/api/auth/login",
            "body": {
              "username": "mina",
              "password": "minapassword"
            }
          },
          "expect": {
            "status": 200
          },
          "save": {
            "m0": "/token"
          }
        },
        {
          "req": {
            "method": "GET",
            "path": "/api/me",
            "auth": "m0"
          },
          "expect": {
            "status": 200,
            "body": {
              "id": "user-mina",
              "role": "manager",
              "$open": true
            }
          }
        },
        {
          "req": {
            "method": "POST",
            "path": "/api/users",
            "auth": "a0",
            "body": {
              "username": "nope",
              "password": "nopepassword",
              "role": "root"
            }
          },
          "expect": {
            "status": 400,
            "body": {
              "error": "unknown role"
            }
          }
        }
      ]
    },
    {
      "name": "a manager may rename and order libraries and start scans, and nothing else about them",
