{
  "tier": "v1",
  "description": "The lists module from a fresh server (the pasted-code answer is the link as stored before its first import, Go's answer, so its entry_count is 0): the tracking list, linked accounts, the OAuth and pin flows, imports, scrobble preferences and unlinking (D-078..D-083). The flows that reach AniList need the upstream fixture server (`upstream`, with LAIN_LISTLINK_ANILIST_GRAPHQL_URL=<upstream>/anilist-list/graphql and LAIN_LISTLINK_ANILIST_OAUTH_URL=<upstream>/anilist-list/oauth); nothing reaches the network.",
  "cases": [
    {"name": "accounts", "steps": [
      {"req": {"method": "POST", "path": "/api/setup", "body": {"username": "admin", "password": "password123"}}, "expect": {"status": 201}},
      {"req": {"method": "POST", "path": "/api/auth/login", "body": {"username": "admin", "password": "password123"}}, "expect": {"status": 200}, "save": {"admin": "/token"}},
      {"req": {"method": "POST", "path": "/api/users", "auth": "admin", "body": {"username": "bob", "password": "bobpassword"}}, "expect": {"status": 201}},
      {"req": {"method": "POST", "path": "/api/auth/login", "body": {"username": "bob", "password": "bobpassword"}}, "expect": {"status": 200}, "save": {"bob": "/token"}}
    ]},
    {"name": "every route needs a session except the OAuth landing", "steps": [
      {"req": {"method": "GET", "path": "/api/list"}, "expect": {"status": 401, "body": {"error": "unauthorized"}}},
      {"req": {"method": "GET", "path": "/api/me/links"}, "expect": {"status": 401}},
      {"req": {"method": "GET", "path": "/api/me/links/anilist/authorize"}, "expect": {"status": 401}},
      {"req": {"method": "POST", "path": "/api/me/links/anilist/sync"}, "expect": {"status": 401}},
      {"req": {"method": "GET", "path": "/api/admin/settings/integrations", "auth": "bob"}, "expect": {"status": 403, "body": {"error": "admin required"}}}
    ]},
    {"name": "nothing linked yet", "steps": [
      {"req": {"method": "GET", "path": "/api/me/links", "auth": "bob"}, "expect": {"status": 200, "body": {"links": []}}},
      {"req": {"method": "GET", "path": "/api/list", "auth": "bob"}, "expect": {"status": 200, "body": {"entries": []}}},
      {"req": {"method": "GET", "path": "/api/list?type=manga&status=current", "auth": "bob"}, "expect": {"status": 200, "body": {"entries": []}}},
      {"req": {"method": "POST", "path": "/api/me/links/anilist/sync", "auth": "bob"}, "expect": {"status": 404, "body": {"error": "no anilist account linked"}}},
      {"req": {"method": "DELETE", "path": "/api/me/links/anilist", "auth": "bob"}, "expect": {"status": 404, "body": {"error": "no anilist account linked"}}},
      {"req": {"method": "PATCH", "path": "/api/me/links/anilist", "auth": "bob", "body": {"scrobble": true}}, "expect": {"status": 404, "body": {"error": "no anilist account linked"}}},
      {"req": {"method": "PATCH", "path": "/api/me/links/anilist", "auth": "bob", "body": {}}, "expect": {"status": 400, "body": {"error": "scrobble (boolean) required"}}},
      {"req": {"method": "PATCH", "path": "/api/me/links/anilist", "auth": "bob", "raw_body": "{\"scrobble\": \"yes\"}"}, "expect": {"status": 400, "body": {"error": "scrobble (boolean) required"}}}
    ]},
    {"name": "the OAuth flow needs an operator client", "steps": [
      {"req": {"method": "GET", "path": "/api/me/links/anilist/authorize", "auth": "bob"},
       "expect": {"status": 503, "body": {"error": "no OAuth client configured for anilist", "code": "not-configured"}}},
      {"req": {"method": "GET", "path": "/api/me/links/trakt/authorize", "auth": "bob"},
       "expect": {"status": 503, "body": {"error": "no OAuth client configured for trakt", "code": "not-configured"}}}
    ]},
    {"name": "the pin flow uses the official app", "steps": [
      {"req": {"method": "GET", "path": "/api/me/links/anilist/pin", "auth": "bob"},
       "expect": {"status": 200, "body": {"url": "https://anilist.co/api/v2/oauth/authorize?client_id=52227&redirect_uri=https%3A%2F%2Fanilist.co%2Fapi%2Fv2%2Foauth%2Fpin&response_type=code"}}},
      {"req": {"method": "GET", "path": "/api/me/links/trakt/pin", "auth": "bob"},
       "expect": {"status": 503, "body": {"error": "no pin client configured for trakt", "code": "not-configured"}}},
      {"req": {"method": "POST", "path": "/api/me/links/trakt/code", "auth": "bob", "body": {"code": "x"}},
       "expect": {"status": 503, "body": {"code": "not-configured", "$open": true}}},
      {"req": {"method": "POST", "path": "/api/me/links/anilist/code", "auth": "bob", "body": {"code": "  "}}, "expect": {"status": 400, "body": {"error": "code is required"}}},
      {"req": {"method": "POST", "path": "/api/me/links/anilist/code", "auth": "bob", "raw_body": "nope"}, "expect": {"status": 400, "body": {"error": "invalid json"}}}
    ]},
    {"name": "the callback refuses bad input", "steps": [
      {"req": {"method": "GET", "path": "/api/auth/anilist/callback?error=access_denied"},
       "expect": {"status": 302, "headers": {"Location": "/settings/connections?link_error=denied"}}},
      {"req": {"method": "GET", "path": "/api/auth/anilist/callback?code=x&state=bogus"}, "expect": {"status": 400, "body": {"error": "bad link state or code"}}},
      {"req": {"method": "GET", "path": "/api/auth/anilist/callback?state=a.b"}, "expect": {"status": 400, "body": {"error": "bad link state or code"}}}
    ]},
    {"name": "an operator client starts a signed flow", "steps": [
      {"req": {"method": "PUT", "path": "/api/admin/settings/integrations", "auth": "admin", "body": {"anilist_client_id": "12345", "anilist_client_secret": "sekret-client"}},
       "expect": {"status": 200, "body": {"platforms": {"anilist": {"client_id": "12345", "secret_set": true, "callback_url": "$substr:/api/auth/anilist/callback"}}}}},
      {"req": {"method": "GET", "path": "/api/me/links/anilist/authorize", "auth": "bob"},
       "expect": {"status": 200, "body": {"url": "$substr:/authorize?client_id=12345&redirect_uri=http%3A%2F%2F"}}, "save": {"state": "/url?state"}},
      {"req": {"method": "GET", "path": "/api/me/links/anilist/authorize", "auth": "bob"},
       "expect": {"status": 200, "body": {"url": "$substr:%2Fapi%2Fauth%2Fanilist%2Fcallback&response_type=code&state="}}},
      {"req": {"method": "GET", "path": "/api/auth/mal/callback?code=good-code&state={{state}}"}, "expect": {"status": 400, "body": {"error": "bad link state or code"}}},
      {"req": {"method": "GET", "path": "/api/me/links/trakt/authorize", "auth": "bob"},
       "expect": {"status": 503, "body": {"code": "not-configured", "$open": true}}}
    ]},
    {"name": "a refused code links nothing", "requires": ["upstream"], "steps": [
      {"req": {"method": "GET", "path": "/api/auth/anilist/callback?code=bad-code&state={{state}}"},
       "expect": {"status": 302, "headers": {"Location": "/settings/connections?link_error=invalid-grant"}}},
      {"req": {"method": "POST", "path": "/api/me/links/anilist/code", "auth": "bob", "body": {"code": "bad-code"}},
       "expect": {"status": 400, "body": {"error": "invalid-grant: The authorization code is invalid", "code": "invalid-grant"}}},
      {"req": {"method": "GET", "path": "/api/me/links", "auth": "bob"}, "expect": {"status": 200, "body": {"links": []}}}
    ]},
    {"name": "the callback links and imports", "requires": ["upstream"], "steps": [
      {"req": {"method": "GET", "path": "/api/auth/anilist/callback?code=good-code&state={{state}}"},
       "expect": {"status": 302, "headers": {"Location": "/settings/connections?linked=anilist"}}},
      {"req": {"method": "GET", "path": "/api/me/links", "auth": "bob"},
       "expect": {"status": 200, "body": {"links": [{"platform": "anilist", "remote_user_id": "7", "remote_username": "watcher",
         "linked_at": "$int", "last_sync_at": "$int", "entry_count": 2, "token_expires_at": 4102444800, "scrobble": false,
         "last_sync_error": "$absent", "token": "$absent", "token_expired": "$absent"}]}}},
      {"req": {"method": "GET", "path": "/api/list", "auth": "bob"},
       "expect": {"status": 200, "body": {"entries": [
         {"id": "anilist:154587", "user_id": "user-bob", "platform": "anilist", "remote_id": "154587", "media_type": "anime", "format": "TV",
          "title": "Frieren: Beyond Journey's End", "cover": "https://img.example/frieren-xl.jpg", "status": "current", "progress": 12,
          "progress_total": 28, "score": 8.5, "started_at": "2026-01-03", "updated_at": "$int", "notes": "$absent", "completed_at": "$absent"},
         {"id": "anilist:30013", "user_id": "user-bob", "platform": "anilist", "remote_id": "30013", "media_type": "manga", "format": "MANGA",
          "title": "One Piece", "cover": "https://img.example/op.jpg", "status": "planning", "progress": 0, "progress_volumes": 7,
          "notes": "peak", "started_at": "2025-09-01", "updated_at": "$int", "progress_total": "$absent", "score": "$absent"}]}}},
      {"req": {"method": "GET", "path": "/api/list?type=manga", "auth": "bob"},
       "expect": {"status": 200, "body": {"entries": [{"remote_id": "30013", "$open": true}]}}},
      {"req": {"method": "GET", "path": "/api/list?status=current", "auth": "bob"},
       "expect": {"status": 200, "body": {"entries": [{"remote_id": "154587", "$open": true}]}}},
      {"req": {"method": "GET", "path": "/api/list", "auth": "admin"}, "expect": {"status": 200, "body": {"entries": []}}},
      {"req": {"method": "GET", "path": "/api/auth/anilist/callback?code=good-code&state=x{{state}}"}, "expect": {"status": 400}}
    ]},
    {"name": "sync, scrobble preference and unlink", "requires": ["upstream"], "steps": [
      {"req": {"method": "POST", "path": "/api/me/links/anilist/sync", "auth": "bob"},
       "expect": {"status": 200, "body": {"status": "ok", "stats": {"upserted": 2, "removed": 0}}}},
      {"req": {"method": "PATCH", "path": "/api/me/links/anilist", "auth": "bob", "body": {"scrobble": true}},
       "expect": {"status": 200, "body": {"platform": "anilist", "scrobble": true, "entry_count": 2, "$open": true}}},
      {"req": {"method": "GET", "path": "/api/me/links", "auth": "bob"}, "expect": {"status": 200, "body": {"links": [{"scrobble": true, "$open": true}]}}},
      {"req": {"method": "DELETE", "path": "/api/me/links/anilist", "auth": "bob"}, "expect": {"status": 200, "body": {"status": "ok", "removed": 2}}},
      {"req": {"method": "GET", "path": "/api/list", "auth": "bob"}, "expect": {"status": 200, "body": {"entries": []}}},
      {"req": {"method": "GET", "path": "/api/me/links", "auth": "bob"}, "expect": {"status": 200, "body": {"links": []}}}
    ]},
    {"name": "a pasted pin URL links too", "requires": ["upstream"], "steps": [
      {"req": {"method": "POST", "path": "/api/me/links/anilist/code", "auth": "bob", "body": {"code": "https://anilist.co/api/v2/oauth/pin?code=good-code"}},
       "expect": {"status": 200, "body": {"link": {"platform": "anilist", "remote_username": "watcher", "entry_count": 0, "scrobble": false, "$open": true}}}},
      {"req": {"method": "GET", "path": "/api/me/links", "auth": "bob"}, "expect": {"status": 200, "body": {"links": [{"entry_count": 2, "last_sync_at": "$int", "$open": true}]}}},
      {"req": {"method": "GET", "path": "/api/list", "auth": "bob"}, "expect": {"status": 200, "body": {"entries": {"$len": 2}}}}
    ]}
  ]
}
