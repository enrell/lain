{
  "tier": "v2",
  "description": "The read module (D-085, D-195) on a lain-rs whose data dir maps root `media` to `media_root` (conformance/fixtures/read, read only) and holds the catalog of conformance/fixtures/read-catalog.json: page indexes, page bytes with ETags, the reading direction, refusals, books (D-303..D-308: manifests, sanitized chapters, resources, PDF pages), private libraries (D-156) and module disable.",
  "cases": [
    {"name": "accounts and the library", "requires": ["media_root"], "steps": [
      {"req": {"method": "POST", "path": "/api/setup", "body": {"username": "admin", "password": "password123"}}, "expect": {"status": 201}},
      {"req": {"method": "POST", "path": "/api/auth/login", "body": {"username": "admin", "password": "password123"}}, "expect": {"status": 200}, "save": {"a": "/token"}},
      {"req": {"method": "POST", "path": "/api/users", "auth": "a", "body": {"username": "bob", "password": "bobpassword"}}, "expect": {"status": 201}},
      {"req": {"method": "POST", "path": "/api/auth/login", "body": {"username": "bob", "password": "bobpassword"}}, "expect": {"status": 200}, "save": {"b": "/token"}},
      {"req": {"method": "POST", "path": "/api/libraries", "auth": "a", "body": {"name": "Read", "type": "manga", "root": "media", "path": "Read"}}, "expect": {"status": 201, "body": {"id": "lib-7186ff8c", "$open": true}}, "save": {"lib": "/id"}},
      {"req": {"method": "GET", "path": "/api/modules", "auth": "a"}, "expect": {"status": 200, "body": {"modules": {"$contains": [{"id": "read", "state": "active", "$open": true}]}, "$open": true}}}
    ]},
    {"name": "a manga's page index", "requires": ["lib"], "steps": [
      {"req": {"method": "GET", "path": "/api/items/item-read-manga/pages", "auth": "b"}, "expect": {"status": 200, "body": {"kind": "manga", "format": "cbz", "direction": "rtl", "pages": [{"index": 0, "mime": "image/png", "size": "$int", "width": 16, "height": 24}, {"index": 1, "mime": "image/png", "size": "$int", "width": 16, "height": 24}, {"index": 2, "mime": "image/png", "size": "$int", "width": 16, "height": 24}]}}},
      {"req": {"method": "GET", "path": "/api/items/item-read-manga/pages"}, "expect": {"status": 401, "body": {"error": "unauthorized"}}}
    ]},
    {"name": "page bytes, ETags and the query token", "requires": ["lib"], "steps": [
      {"req": {"method": "GET", "path": "/api/items/item-read-manga/pages/1", "auth": "b"}, "expect": {"status": 200, "headers": {"content-type": "image/png", "cache-control": "private, max-age=86400", "etag": "$prefix:\"595-"}}},
      {"req": {"method": "GET", "path": "/api/items/item-read-manga/pages/0", "auth": "query:b"}, "expect": {"status": 200, "headers": {"content-type": "image/png"}}},
      {"req": {"method": "GET", "path": "/api/items/item-read-manga/pages/0"}, "expect": {"status": 401, "body": {"error": "unauthorized"}}},
      {"req": {"method": "GET", "path": "/api/items/item-read-manga/pages/3", "auth": "b"}, "expect": {"status": 404, "body": {"error": "no such page"}}},
      {"req": {"method": "GET", "path": "/api/items/item-read-manga/pages/-1", "auth": "b"}, "expect": {"status": 400, "body": {"error": "bad page"}}},
      {"req": {"method": "GET", "path": "/api/items/item-read-manga/pages/x", "auth": "b"}, "expect": {"status": 400, "body": {"error": "bad page"}}}
    ]},
    {"name": "a matching If-None-Match is a 304", "requires": ["lib"], "steps": [
      {"req": {"method": "GET", "path": "/api/items/item-read-comic/pages", "auth": "b"}, "expect": {"status": 200, "body": {"pages": [{"index": 0, "size": "$int", "$open": true}], "$open": true}}, "save": {"psize": "/pages/0/size"}},
      {"req": {"method": "GET", "path": "/api/items/item-read-comic/pages/0", "auth": "b", "headers": {"If-None-Match": "\"380-{{psize}}-0\""}}, "expect": {"status": 304, "headers": {"etag": "\"380-{{psize}}-0\""}}},
      {"req": {"method": "GET", "path": "/api/items/item-read-comic/pages/0", "auth": "b", "headers": {"If-None-Match": "\"0-0-0\""}}, "expect": {"status": 200, "headers": {"etag": "\"380-{{psize}}-0\""}}}
    ]},
    {"name": "ComicInfo.xml declares the direction", "requires": ["lib"], "steps": [
      {"req": {"method": "GET", "path": "/api/items/item-read-comic/pages", "auth": "b"}, "expect": {"status": 200, "body": {"kind": "comic", "format": "cbz", "direction": "rtl", "pages": [{"index": 0, "mime": "image/png", "size": "$int", "width": 4, "height": 6}], "info": {"series": "Tiny Blade", "number": "1.5", "direction": "rtl"}}}}
    ]},
    {"name": "what cannot be read", "requires": ["lib"], "steps": [
      {"req": {"method": "GET", "path": "/api/items/item-read-video/pages", "auth": "b"}, "expect": {"status": 400, "body": {"error": "item is not readable"}}},
      {"req": {"method": "GET", "path": "/api/items/item-read-gone/pages", "auth": "b"}, "expect": {"status": 404, "body": {"error": "file unavailable"}}},
      {"req": {"method": "GET", "path": "/api/items/item-read-broken/pages", "auth": "b"}, "expect": {"status": 422, "body": {"error": "$prefix:invalid-archive: "}}},
      {"req": {"method": "GET", "path": "/api/items/item-read-broken/pages/0", "auth": "b"}, "expect": {"status": 422, "body": {"error": "$prefix:invalid-archive: "}}},
      {"req": {"method": "GET", "path": "/api/items/nope/pages", "auth": "b"}, "expect": {"status": 404, "body": {"error": "unknown item"}}},
      {"req": {"method": "GET", "path": "/api/items/nope/pages/0", "auth": "b"}, "expect": {"status": 404, "body": {"error": "unknown item"}}}
    ]},
    {"name": "a book's manifest (D-306)", "requires": ["lib"], "steps": [
      {"req": {"method": "GET", "path": "/api/items/item-read-epub/book", "auth": "b"}, "expect": {"status": 200, "body": {"format": "epub", "layout": "reflowable", "title": "Tiny Book", "authors": ["A. Writer"], "language": "en", "description": "A small book for the tests.", "subjects": ["Fixtures"], "published": "2001", "direction": "ltr", "chapters": [{"index": 0, "chars": "$int", "linear": true}, {"index": 1, "chars": 7, "linear": true}], "toc": [{"title": "One", "chapter": 0, "page": -1}, {"title": "Two", "chapter": 1, "anchor": "end", "page": -1}], "pages": 1, "count_rule": "text@1"}}},
      {"req": {"method": "GET", "path": "/api/items/item-read-pdf/book", "auth": "b"}, "expect": {"status": 200, "body": {"format": "pdf", "layout": "pages", "title": "Tiny Pages", "authors": ["A. Writer"], "published": "2002", "direction": "ltr", "toc": [{"title": "Page two", "chapter": -1, "page": 1}], "pages": 2, "$open": true}}},
      {"req": {"method": "GET", "path": "/api/items/item-read-epub/book"}, "expect": {"status": 401, "body": {"error": "unauthorized"}}}
    ]},
    {"name": "a chapter is sanitized and sandboxed", "requires": ["lib"], "steps": [
      {"req": {"method": "GET", "path": "/api/items/item-read-epub/book/chapters/0", "auth": "b"}, "expect": {"status": 200, "headers": {"content-type": "text/html; charset=utf-8", "content-security-policy": "$prefix:sandbox", "etag": "$prefix:\"2192-"}, "body": "$prefix:<!DOCTYPE html>"}},
      {"req": {"method": "GET", "path": "/api/items/item-read-epub/book/chapters/0", "auth": "b"}, "expect": {"status": 200, "body": "$substr:href=\"#end\" data-lain-chapter=\"1\" data-lain-anchor=\"end\""}},
      {"req": {"method": "GET", "path": "/api/items/item-read-epub/book/chapters/0", "auth": "b"}, "expect": {"status": 200, "body": "$substr:<img src=\"/api/items/item-read-epub/book/res/OEBPS/cover.png\" alt=\"cover\">"}},
      {"req": {"method": "GET", "path": "/api/items/item-read-epub/book/chapters/0", "auth": "b"}, "expect": {"status": 200, "body": "$lacks:steal"}},
      {"req": {"method": "GET", "path": "/api/items/item-read-epub/book/chapters/0", "auth": "query:b"}, "expect": {"status": 200}},
      {"req": {"method": "GET", "path": "/api/items/item-read-epub/book/chapters/2", "auth": "b"}, "expect": {"status": 404, "body": {"code": "not-found", "$open": true}}},
      {"req": {"method": "GET", "path": "/api/items/item-read-epub/book/chapters/x", "auth": "b"}, "expect": {"status": 400, "body": {"error": "bad chapter"}}}
    ]},
    {"name": "a book's resources", "requires": ["lib"], "steps": [
      {"req": {"method": "GET", "path": "/api/items/item-read-epub/book/res/OEBPS/cover.png", "auth": "query:b"}, "expect": {"status": 200, "headers": {"content-type": "image/png", "cache-control": "private, max-age=86400", "content-security-policy": "$prefix:sandbox"}}},
      {"req": {"method": "GET", "path": "/api/items/item-read-epub/book/res/OEBPS/style.css", "auth": "b"}, "expect": {"status": 200, "headers": {"content-type": "text/css"}, "body": "$substr:url(\"/api/items/item-read-epub/book/res/OEBPS/cover.png\")"}},
      {"req": {"method": "GET", "path": "/api/items/item-read-epub/book/res/OEBPS/one.xhtml", "auth": "b"}, "expect": {"status": 200, "headers": {"content-type": "text/plain; charset=utf-8"}}},
      {"req": {"method": "GET", "path": "/api/items/item-read-epub/book/res/META-INF/container.xml", "auth": "b"}, "expect": {"status": 404, "body": {"code": "not-found", "$open": true}}},
      {"req": {"method": "GET", "path": "/api/items/item-read-epub/book/res/OEBPS/missing.png", "auth": "b"}, "expect": {"status": 404, "body": {"code": "not-found", "$open": true}}}
    ]},
    {"name": "a PDF is read page by page", "requires": ["lib"], "steps": [
      {"req": {"method": "GET", "path": "/api/items/item-read-pdf/pages", "auth": "b"}, "expect": {"status": 200, "body": {"kind": "book", "format": "pdf", "direction": "ltr", "pages": [{"index": 0, "mime": "image/png", "size": 0, "width": 200, "height": 300}, {"index": 1, "mime": "image/png", "size": 0, "width": 200, "height": 300}]}}},
      {"req": {"method": "GET", "path": "/api/items/item-read-pdf/pages/1?w=100", "auth": "query:b"}, "expect": {"status": 200, "headers": {"content-type": "image/png", "cache-control": "private, max-age=86400", "etag": "$prefix:\"873-"}}},
      {"req": {"method": "GET", "path": "/api/items/item-read-pdf/pages/0", "auth": "b"}, "expect": {"status": 200, "headers": {"content-type": "image/png"}}},
      {"req": {"method": "GET", "path": "/api/items/item-read-pdf/pages/0?w=9", "auth": "b"}, "expect": {"status": 400, "body": {"error": "bad width"}}},
      {"req": {"method": "GET", "path": "/api/items/item-read-pdf/pages/2", "auth": "b"}, "expect": {"status": 404, "body": {"error": "no such page"}}},
      {"req": {"method": "GET", "path": "/api/items/item-read-epub/pages", "auth": "b"}, "expect": {"status": 400, "body": {"error": "this book is read by chapters", "code": "reflowable-book"}}},
      {"req": {"method": "GET", "path": "/api/items/item-read-pdf/book/chapters/0", "auth": "b"}, "expect": {"status": 404, "body": {"code": "not-found", "$open": true}}}
    ]},
    {"name": "what is not a readable book", "requires": ["lib"], "steps": [
      {"req": {"method": "GET", "path": "/api/items/item-read-book-broken/book", "auth": "b"}, "expect": {"status": 422, "body": {"code": "invalid-book", "$open": true}}},
      {"req": {"method": "GET", "path": "/api/items/item-read-book-broken/book/chapters/0", "auth": "b"}, "expect": {"status": 422, "body": {"code": "invalid-book", "$open": true}}},
      {"req": {"method": "GET", "path": "/api/items/item-read-manga/book", "auth": "b"}, "expect": {"status": 400, "body": {"error": "item is not a book", "code": "not-a-book"}}},
      {"req": {"method": "GET", "path": "/api/items/nope/book", "auth": "b"}, "expect": {"status": 404, "body": {"error": "unknown item"}}}
    ]},
    {"name": "a private library hides pages from everyone who has not unlocked it", "requires": ["lib"], "steps": [
      {"req": {"method": "PUT", "path": "/api/me/pin", "auth": "a", "body": {"pin": "2468", "password": "password123"}}, "expect": {"status": 200}},
      {"req": {"method": "PATCH", "path": "/api/libraries/{{lib}}", "auth": "a", "body": {"private": true}}, "expect": {"status": 200, "body": {"locked": true, "$open": true}}},
      {"req": {"method": "GET", "path": "/api/items/item-read-manga/pages", "auth": "b"}, "expect": {"status": 404, "body": {"error": "unknown item"}}},
      {"req": {"method": "GET", "path": "/api/items/item-read-epub/book", "auth": "b"}, "expect": {"status": 404, "body": {"error": "unknown item"}}},
      {"req": {"method": "GET", "path": "/api/items/item-read-epub/book/res/OEBPS/cover.png", "auth": "query:b"}, "expect": {"status": 404, "body": {"error": "unknown item"}}},
      {"req": {"method": "GET", "path": "/api/items/item-read-manga/pages/0", "auth": "query:b"}, "expect": {"status": 404, "body": {"error": "unknown item"}}},
      {"req": {"method": "GET", "path": "/api/items/item-read-manga/pages", "auth": "a"}, "expect": {"status": 404, "body": {"error": "unknown item"}}},
      {"req": {"method": "GET", "path": "/api/items/item-read-manga/pages/0", "auth": "a"}, "expect": {"status": 404, "body": {"error": "unknown item"}}},
      {"req": {"method": "POST", "path": "/api/libraries/{{lib}}/unlock", "auth": "a", "body": {"pin": "2468"}}, "expect": {"status": 200, "body": {"locked": false, "$open": true}}},
      {"req": {"method": "GET", "path": "/api/items/item-read-manga/pages", "auth": "a"}, "expect": {"status": 200, "body": {"kind": "manga", "$open": true}}},
      {"req": {"method": "GET", "path": "/api/items/item-read-manga/pages/0", "auth": "a"}, "expect": {"status": 200, "headers": {"content-type": "image/png"}}},
      {"req": {"method": "GET", "path": "/api/items/item-read-manga/pages", "auth": "b"}, "expect": {"status": 404, "body": {"error": "unknown item"}}},
      {"req": {"method": "PATCH", "path": "/api/libraries/{{lib}}", "auth": "a", "body": {"private": false}}, "expect": {"status": 200}}
    ]},
    {"name": "disabling the read module unmounts the routes", "requires": ["lib", "data_dir"], "steps": [
      {"write_file": {"path": "{{data_dir}}/modules.json", "json": {"format": "lain.modules@1", "modules": [{"id": "read", "enabled": false}]}}},
      {"wait_for": {"req": {"method": "GET", "path": "/api/items/item-read-manga/pages", "auth": "b"}, "expect": {"status": 404, "body": {"error": "module read is disabled", "code": "module-disabled", "module": "read"}}}},
      {"req": {"method": "GET", "path": "/api/items/item-read-manga/pages/0", "auth": "b"}, "expect": {"status": 404, "body": {"code": "module-disabled", "$open": true}}},
      {"req": {"method": "GET", "path": "/api/items/item-read-epub/book", "auth": "b"}, "expect": {"status": 404, "body": {"code": "module-disabled", "$open": true}}},
      {"req": {"method": "GET", "path": "/api/items/item-read-epub/book/chapters/0", "auth": "b"}, "expect": {"status": 404, "body": {"code": "module-disabled", "$open": true}}},
      {"remove_file": "{{data_dir}}/modules.json"},
      {"wait_for": {"req": {"method": "GET", "path": "/api/items/item-read-manga/pages", "auth": "b"}, "expect": {"status": 200}}}
    ]}
  ]
}
