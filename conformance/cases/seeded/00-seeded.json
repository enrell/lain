{
  "tier": "v1",
  "description": "Reads over the state the seed suite wrote: the same assertions hold on the Go server that wrote it and on a Rust server that imported it (`lain-rs import`). Needs the seed's saved variables (--vars).",
  "cases": [
    {"name": "seeded passwords log in", "requires": ["lib_id"], "steps": [
      {"req": {"method": "POST", "path": "/api/auth/login", "body": {"username": "admin", "password": "password123"}}, "expect": {"status": 200}, "save": {"admin_token": "/token"}},
      {"req": {"method": "POST", "path": "/api/auth/login", "body": {"username": "bob", "password": "bobpassword"}}, "expect": {"status": 200}, "save": {"bob_token": "/token"}},
      {"req": {"method": "GET", "path": "/api/setup/status"}, "expect": {"status": 200, "body": {"setup_required": false}}}
    ]},
    {"name": "a token minted before the move still verifies", "requires": ["go_token"], "steps": [
      {"req": {"method": "GET", "path": "/api/me", "auth": "go_token"},
       "expect": {"status": 200, "body": {"id": "user-admin", "username": "admin", "pass_hash": null, "role": "admin", "disabled": false, "pwd_ver": 1,
         "created_at": "$int", "preferred_language": "jpn", "playback": {},
         "profile": {"display_name": "The Admin", "avatar": {"kind": "mascot", "mascot": "orbit", "version": "$int"}}}}}
    ]},
    {"name": "users survive", "requires": ["lib_id"], "steps": [
      {"req": {"method": "GET", "path": "/api/users", "auth": "admin_token"},
       "expect": {"status": 200, "body": [{"id": "user-admin", "$open": true}, {"id": "user-bob", "username": "bob", "role": "user", "pass_hash": null, "$open": true}]}}
    ]},
    {"name": "libraries survive", "requires": ["lib_id", "media_dir"], "steps": [
      {"req": {"method": "GET", "path": "/api/libraries", "auth": "bob_token"},
       "expect": {"status": 200, "body": [{"id": "{{lib_id}}", "name": "Anime", "type": "anime", "path": "{{media_dir}}", "source": "lain-source-filesystem", "created_at": "$int"}]}}
    ]},
    {"name": "the catalog lists in title order", "requires": ["lib_id", "media_dir"], "steps": [
      {"req": {"method": "GET", "path": "/api/catalog", "auth": "admin_token"},
       "expect": {"status": 200, "body": {"total": 2, "limit": 50, "offset": 0, "items": [
         {"id": "{{item1}}", "library_id": "{{lib_id}}", "kind": "episode", "title": "Frieren", "season": 0, "episode": 1, "year": 0,
          "file_path": "$prefix:{{media_dir}}", "size": 0, "confidence": "$number", "origin": "lain-identify-anime",
          "provenance": "identify:lain-identify-anime", "updated_at": "$int"},
         {"id": "{{item2}}", "library_id": "{{lib_id}}", "kind": "episode", "title": "Frieren", "season": 0, "episode": 2, "year": 0,
          "file_path": "$prefix:{{media_dir}}", "size": 0, "confidence": "$number", "origin": "lain-identify-anime",
          "provenance": "identify:lain-identify-anime", "updated_at": "$int"}]}}}
    ]},
    {"name": "catalog paging and filters", "requires": ["lib_id"], "steps": [
      {"req": {"method": "GET", "path": "/api/catalog?limit=1&offset=1", "auth": "admin_token"},
       "expect": {"status": 200, "body": {"total": 2, "limit": 1, "offset": 1, "items": [{"id": "{{item2}}", "$open": true}]}}},
      {"req": {"method": "GET", "path": "/api/catalog?offset=5", "auth": "admin_token"}, "expect": {"status": 200, "body": {"total": 2, "limit": 50, "offset": 5, "items": []}}},
      {"req": {"method": "GET", "path": "/api/catalog?library_id={{lib_id}}", "auth": "admin_token"}, "expect": {"status": 200, "body": {"total": 2, "$open": true}}},
      {"req": {"method": "GET", "path": "/api/catalog?library_id=lib-other", "auth": "admin_token"}, "expect": {"status": 200, "body": {"total": 0, "items": [], "$open": true}}},
      {"req": {"method": "GET", "path": "/api/catalog?sort=recent", "auth": "admin_token"}, "expect": {"status": 200, "body": {"total": 2, "items": {"$len": 2}, "$open": true}}}
    ]},
    {"name": "one item and its title's episodes", "requires": ["lib_id"], "steps": [
      {"req": {"method": "GET", "path": "/api/catalog/{{item2}}", "auth": "bob_token"},
       "expect": {"status": 200, "body": {"id": "{{item2}}", "episode": 2, "title": "Frieren", "$open": true}}},
      {"req": {"method": "GET", "path": "/api/catalog/{{item2}}/episodes", "auth": "bob_token"},
       "expect": {"status": 200, "body": {"items": [{"id": "{{item1}}", "episode": 1, "$open": true}, {"id": "{{item2}}", "episode": 2, "$open": true}]}}}
    ]},
    {"name": "progress survives per user", "requires": ["lib_id"], "steps": [
      {"req": {"method": "GET", "path": "/api/items/{{item1}}/progress", "auth": "admin_token"},
       "expect": {"status": 200, "body": {"item_id": "{{item1}}", "user_id": "user-admin", "position_sec": 30, "duration_sec": 1440, "completed": false, "updated_at": "$int"}}},
      {"req": {"method": "GET", "path": "/api/items/{{item2}}/progress", "auth": "bob_token"},
       "expect": {"status": 200, "body": {"item_id": "{{item2}}", "user_id": "user-bob", "position_sec": 1440, "duration_sec": 1440, "completed": true, "updated_at": "$int"}}},
      {"req": {"method": "GET", "path": "/api/items/{{item1}}/progress", "auth": "bob_token"}, "expect": {"status": 200, "body": {"item_id": "", "$open": true}}},
      {"req": {"method": "GET", "path": "/api/me/continue", "auth": "admin_token"}, "expect": {"status": 200, "body": [{"item_id": "{{item1}}", "$open": true}]}}
    ]}
  ]
}
