{
  "tier": "v1",
  "description": "Uploaded avatars (D-086): content-sniffed pictures stored per user, served to any signed-in user (bearer or ?token=), retired by a mascot pick or DELETE.",
  "cases": [
    {"name": "upload and serve", "steps": [
      {"req": {"method": "PUT", "path": "/api/me/avatar", "auth": "admin_token", "headers": {"Content-Type": "image/png"}, "raw_body_hex": "89504e470d0a1a0a0000000d4948445200000008000000080800000000e164e157000000304944415478da63601050307008482860e090d0b0f088c8a88009343040053a18a0021318a0023318a0020b18a0022b0080e6150108904dcd0000000049454e44ae426082"},
       "expect": {"status": 200, "body": {"id": "user-admin", "profile": {"avatar": {"kind": "upload", "version": "$int"}, "$open": true}, "$open": true}}},
      {"req": {"method": "GET", "path": "/api/users/user-admin/avatar", "auth": "query:admin_token"},
       "expect": {"status": 200, "headers": {"content-type": "image/png", "x-content-type-options": "nosniff", "cache-control": "private, max-age=31536000, immutable"}, "body_hex": "89504e470d0a1a0a0000000d4948445200000008000000080800000000e164e157000000304944415478da63601050307008482860e090d0b0f088c8a88009343040053a18a0021318a0023318a0020b18a0022b0080e6150108904dcd0000000049454e44ae426082"}},
      {"req": {"method": "GET", "path": "/api/users/user-admin/avatar", "auth": "bob_token"}, "expect": {"status": 200, "body_hex": "89504e470d0a1a0a0000000d4948445200000008000000080800000000e164e157000000304944415478da63601050307008482860e090d0b0f088c8a88009343040053a18a0021318a0023318a0020b18a0022b0080e6150108904dcd0000000049454e44ae426082"}},
      {"req": {"method": "GET", "path": "/api/users/user-admin/avatar"}, "expect": {"status": 401, "body": {"error": "unauthorized"}}},
      {"req": {"method": "GET", "path": "/api/users/user-bob/avatar", "auth": "admin_token"}, "expect": {"status": 404, "body": {"error": "no avatar"}}},
      {"req": {"method": "GET", "path": "/api/users/user-nobody/avatar", "auth": "admin_token"}, "expect": {"status": 404, "body": {"error": "no avatar"}}}
    ]},
    {"name": "uploads are identified by content", "steps": [
      {"req": {"method": "PUT", "path": "/api/me/avatar", "auth": "admin_token", "headers": {"Content-Type": "image/png"}, "raw_body": "<svg onload=alert(1)>"},
       "expect": {"status": 415, "body": {"error": "use a PNG, JPEG, GIF or WebP image up to 4096 px per side"}}},
      {"req": {"method": "PUT", "path": "/api/me/avatar", "auth": "admin_token", "raw_body_hex": "89504e470d0a1a0a0000000d4948445200001388000000010800000000177a1b540000000049454e44ae426082"},
       "expect": {"status": 415, "body": {"error": "use a PNG, JPEG, GIF or WebP image up to 4096 px per side"}}},
      {"req": {"method": "PUT", "path": "/api/me/avatar", "raw_body_hex": "89504e470d0a1a0a0000000d4948445200000008000000080800000000e164e157000000304944415478da63601050307008482860e090d0b0f088c8a88009343040053a18a0021318a0023318a0020b18a0022b0080e6150108904dcd0000000049454e44ae426082"}, "expect": {"status": 401, "body": {"error": "unauthorized"}}}
    ]},
    {"name": "a mascot retires the upload", "steps": [
      {"req": {"method": "PATCH", "path": "/api/me/profile", "auth": "admin_token", "body": {"mascot": "moth"}},
       "expect": {"status": 200, "body": {"profile": {"avatar": {"kind": "mascot", "mascot": "moth", "version": "$int"}, "$open": true}, "$open": true}}},
      {"req": {"method": "GET", "path": "/api/users/user-admin/avatar", "auth": "admin_token"}, "expect": {"status": 404, "body": {"error": "no avatar"}}}
    ]},
    {"name": "delete clears the avatar", "steps": [
      {"req": {"method": "PUT", "path": "/api/me/avatar", "auth": "bob_token", "raw_body_hex": "89504e470d0a1a0a0000000d4948445200000008000000080800000000e164e157000000304944415478da63601050307008482860e090d0b0f088c8a88009343040053a18a0021318a0023318a0020b18a0022b0080e6150108904dcd0000000049454e44ae426082"},
       "expect": {"status": 200, "body": {"id": "user-bob", "profile": {"avatar": {"kind": "upload", "version": "$int"}, "$open": true}, "$open": true}}},
      {"req": {"method": "DELETE", "path": "/api/me/avatar", "auth": "bob_token"},
       "expect": {"status": 200, "body": {"id": "user-bob", "profile": {"avatar": {"version": "$int"}, "$open": true}, "$open": true}}},
      {"req": {"method": "GET", "path": "/api/users/user-bob/avatar", "auth": "bob_token"}, "expect": {"status": 404, "body": {"error": "no avatar"}}},
      {"req": {"method": "DELETE", "path": "/api/me/avatar"}, "expect": {"status": 401, "body": {"error": "unauthorized"}}}
    ]}
  ]
}
