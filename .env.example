# Lain local configuration. Copy to `.env` and adjust:
#   cp .env.example .env
# Docker Compose reads this file automatically. For a native dev server,
# export it first: `set -a; source .env; set +a`.
# Never commit `.env` (it is gitignored); only `.env.example` is tracked.

# --- Docker Compose (production-like) --------------------------------------
# Server image tag: a release (v0.2.0) or `latest`.
LAIN_TAG=latest
# Host port mapped to the container's 9360.
LAIN_PORT=9360

# --- Native dev server ------------------------------------------------------
# Local port. Keep 9360 for the Docker instance and use 9361 here so both
# can run side by side.
LAIN_DEV_PORT=9361
# Fresh Bolt database for development. NEVER point this at the Docker data
# directory (~/.local/share/lain): two processes must not share one database.
LAIN_DEV_DATA_DIR=/home/lain/.local/share/lain-dev
# Media root served read-only to the dev server. Libraries are registered
# with host paths (e.g. /home/lain/Videos/Animes).
LAIN_DEV_MEDIA_DIR=/home/lain/Videos

# Optional: expose the host's current Omarchy palette to Docker so the
# Svelte web UI follows theme changes. Keep /dev/null outside Omarchy.
LAIN_OMARCHY_CURRENT=/dev/null

# --- QA agent fleet (`just agent-e2e`, `just agent-fix`) --------------------
# Which model drives the specialist auditors. Required: the fleet refuses to
# run on a built-in default, because every report must name a model the
# contributor actually chose. Format is provider/model[#variant]; authenticate
# the provider first with `opencode2 auth`.
LAIN_AGENT_MODEL=
# Optional: a different (usually stronger) model for the remediation engineer.
# Defaults to LAIN_AGENT_MODEL.
# LAIN_AGENT_MODEL_FIXER=
# Path to the OpenCode V2 CLI. V1 cannot read this repository's config.
# LAIN_AGENT_OPENCODE=opencode2
# Browser backend: auto (probe, prefer the integrated browser, else CDP),
# cdp (always drive Chromium through qa/browser.mjs), or integrated
# (OpenCode's own browser tools; needs the desktop client attached).
# LAIN_AGENT_BROWSER=auto
# Chromium binary used by qa/browser.mjs.
# LAIN_AGENT_CHROMIUM=chromium
# Default viewport for audits, WIDTHxHEIGHT.
# LAIN_AGENT_VIEWPORT=1440x900
# Which specialists run, and which severities must converge before `agent-fix`
# stops iterating.
# LAIN_AGENT_SEEDS=usability,ui,a11y,responsive,reliability
# LAIN_AGENT_BLOCKING=blocker,major
# Fix/verify rounds before the loop gives up and reports honestly.
# LAIN_AGENT_MAX_ROUNDS=3
# Per-session budgets in milliseconds: audit, remediation, re-test. An auditor
# that runs out of time mid-journey gets one salvage ask for its report.
# LAIN_AGENT_TIMEOUT_MS=1500000
# LAIN_AGENT_FIX_TIMEOUT_MS=1800000
# LAIN_AGENT_VERIFY_TIMEOUT_MS=900000
# Branch the engineer commits verified fixes to. Never pushed, never merged:
# a human reviews `just agent-status` and the branch.
# LAIN_AGENT_BRANCH=agent/qa
# Audit an instance you already run instead of a disposable one (dangerous:
# agents mutate what they can see, so point this at a test library).
# LAIN_AGENT_TARGET_URL=
# Leave the disposable instance and its data dir behind after a run.
# LAIN_AGENT_KEEP_INSTANCE=0
