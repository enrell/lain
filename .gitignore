/lain
lain-data/
benchmarks/*
!benchmarks/.gitkeep
*.log
.DS_Store
backups/
*.db
.env
.env.*
# ...except the documented contract, which is tracked.
!.env.example
*.pem
*.key
# Android signing keys (D-278): the release key lives outside the tree and
# reaches CI only as a secret.
*.jks
*.keystore

# frontend build artifacts: the source in web/ is what gets committed
web/node_modules/
web/.svelte-kit/
web/build/
# compiled UI embedded into the lain binary (`just web`, CI, Docker)
crates/lain/webui/*
!crates/lain/webui/.gitkeep

# agent session tooling (never commit)
.opencode/
opencode.json
# QA fleet scratch: runs, disposable instances, chromium profiles
qa/runs/
qa/.cache/
qa/.browser/
qa/.probe/
__pycache__/

# Rust workspace (crates/, conformance/runner)
/target/

# Claude Code local state (worktrees, settings)
/.claude/
