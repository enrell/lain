# Development image: the Rust toolchain plus runtime deps. Source comes
# from a bind mount, so `docker compose watch` restarts `cargo run` on
# every edit (the target dir and registry live in volumes).
FROM rust:1.99-alpine
# ffmpeg ships the VA-API encoder, while Mesa supplies the userspace driver
# needed to open AMD render nodes passed through by the optional GPU compose
# override. The application enables a backend only after its real probe passes.
RUN apk add --no-cache musl-dev ffmpeg mesa-va-gallium
WORKDIR /src
